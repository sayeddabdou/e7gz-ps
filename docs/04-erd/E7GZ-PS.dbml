// E7GZ PS — full schema, 63 tables
// Generated from docs/02-architecture/04 — Data Model & Database Design.md
// Paste into https://dbdiagram.io  (New diagram -> Import -> paste)
// Every table carries id/created_at/updated_at unless stated; only key columns shown.

// ===================== Identity =====================
Table user_account [headercolor: #6366f1, note: '''Anonymisation blanks PII but keeps the id, so every historical reference survives.'''] {
  id uuid [pk]
  full_name text [note: '''freely editable — FR-ACC-07''']
  username citext [unique, note: '''normalised trimmed + case-insensitive — FR-ACC-06''']
  phone_e164 text [unique, note: '''FR-ACC-01''']
  email citext [note: '''not unique — FR-ACC-01''']
  password_hash text [note: '''Argon2id''']
  phone_verified boolean [note: '''THE marketplace activation gate — FR-ACC-02''']
  phone_verified_at timestamptz
  email_verified boolean [note: '''never activates — FR-ACC-02''']
  referral_code text [unique]
  referred_by_code text [note: '''FR-PTS-06''']
  anonymised_at timestamptz [note: '''admin path only — FR-ACC-10''']
  joined_at timestamptz
  // constraint: ux_user_username (WHERE anonymised_at IS NULL)
  // constraint: ux_user_phone
}

Table otp_challenge [headercolor: #6366f1, note: '''Rate limiting and audit share one row.'''] {
  id uuid [pk]
  user_id uuid [note: '''nullable — a destination may be challenged pre-account''']
  purpose text [note: '''PHONE_VERIFICATION · PASSWORD_RESET · PHONE_CHANGE''']
  destination text
  code_hash text [note: '''never stored in clear''']
  expires_at timestamptz [note: '''issued + 5 min — FR-ACC-04''']
  attempts smallint [note: '''max 5 — FR-ACC-04''']
  superseded_at timestamptz [note: '''a new OTP invalidates the previous''']
  consumed_at timestamptz
  // constraint: ux_otp_active (destination, purpose)
}

Table auth_refresh_token [headercolor: #6366f1] {
  id uuid [pk]
  subject_id uuid [note: '''user, venue account or admin''']
  subject_type text [note: '''CUSTOMER · VENUE · ADMIN''']
  token_hash text [unique]
  issued_at timestamptz
  expires_at timestamptz
  rotated_to uuid [note: '''rotation chain''']
  revoked_at timestamptz [note: '''reuse of a rotated token revokes the chain''']
}

Table username_change [headercolor: #6366f1] {
  id uuid [pk]
  user_id uuid
  old_username text
  new_username text
  changed_at timestamptz [note: '''30-day cooldown = MAX(changed_at) — FR-ACC-07''']
}

Table account_anonymisation [headercolor: #6366f1] {
  id uuid [pk]
  user_id uuid
  admin_id uuid
  reason text
  performed_at timestamptz
}

// ===================== Geography =====================
Table area [headercolor: #0891b2, note: '''Deactivation guarded: no assigned venue may be ACTIVE or SUSPENDED — FR-VEN-47.'''] {
  id uuid [pk]
  name text
  name_ar text
  is_active boolean [note: '''governs discovery ONLY — FR-VEN-12''']
  centroid geography [note: '''PostGIS''']
}

// ===================== Venue =====================
Table venue [headercolor: #0d9488, note: '''Marketplace status and account status are INDEPENDENT — FR-VEN-06.'''] {
  id uuid [pk]
  area_id uuid
  name text
  address text
  location geography [note: '''PostGIS KNN — FR-DIS-01/10''']
  marketplace_status enum [note: '''ONBOARDING · ACTIVE · INACTIVE · SUSPENDED''']
  timezone text [note: '''Africa/Cairo''']
  phone text [note: '''counterpart visibility applies — FR-DIS-09''']
}

Table venue_account [headercolor: #0d9488] {
  id uuid [pk]
  venue_id uuid [note: '''UNIQUE — one shared account per venue, FR-VEN-01''']
  login_identifier citext [unique]
  password_hash text [note: '''Argon2id''']
  owner_password_hash text [note: '''Argon2id — NEVER a session, FR-VEN-02''']
  owner_password_changed_at timestamptz [note: '''old value dies immediately — FR-VEN-46''']
  account_status enum [note: '''ENABLED · DISABLED''']
  language_preference text [note: '''en | ar — FR-VEN-40''']
}

Table venue_image [headercolor: #0d9488, note: '''Persist through onboarding, details, edit and navigation — FR-ADM-02.'''] {
  id uuid [pk]
  venue_id uuid
  object_key text [note: '''bytes live in object storage''']
  content_type text
  sort_order int
}

Table venue_activity [headercolor: #0d9488] {
  id uuid [pk]
  venue_id uuid
  activity enum [note: '''PLAYSTATION · BILLIARDS · PING_PONG''']
  // constraint: UNIQUE (venue_id, activity)
}

Table venue_opening_template [headercolor: #0d9488] {
  id uuid [pk]
  venue_id uuid
  version bigint [note: '''bumped on every hours change''']
}

Table venue_opening_day [headercolor: #0d9488] {
  id uuid [pk]
  venue_id uuid
  weekday smallint [note: '''0-6''']
  mode text [note: '''DEFAULT · CUSTOM · CLOSED — FR-VEN-17''']
  local_open time
  local_close time [note: '''may be <= open -> crosses midnight''']
  // constraint: UNIQUE (venue_id, weekday)
}

Table venue_operating_session [headercolor: #0d9488, note: '''Materialized over a rolling 120-day horizon so DST is resolved once — ADR-009.'''] {
  id uuid [pk]
  venue_id uuid
  operating_day date [note: '''the canonical operating-day key''']
  local_start timestamp [note: '''wall clock, for snapshots''']
  local_end timestamp
  session_period tstzrange [note: '''ABSOLUTE instants — the inventory authority''']
  timezone text
  generated_from_version bigint
  // constraint: uq_session_day (venue_id, operating_day)
  // constraint: ck_session_len (> 0, <= 24h)
  // constraint: ex_session_no_overlap EXCLUDE (venue_id =, session_period &&)
}

Table venue_selling_block [headercolor: #0d9488, note: '''A STATE, not an interval. Persists past the declared emergency window — FR-AVL-02, FR-OPS-17.'''] {
  id uuid [pk]
  venue_id uuid
  cause text
  emergency_id uuid
  active boolean
  started_at timestamptz
  ended_at timestamptz
  // constraint: ux_venue_block_active (venue_id) WHERE active
}

// ===================== Resource =====================
Table resource [headercolor: #16a34a, note: '''Base state and operational restriction are INDEPENDENT — a resource may be ACTIVE and unsellable.'''] {
  id uuid [pk]
  venue_id uuid
  activity enum
  name text [note: '''Room n / Pool Table n / Table n — FR-VEN-41''']
  console_type enum [note: '''PS4 · PS5 — NOT NULL iff PlayStation''']
  base_state enum [note: '''ACTIVE · DISABLED · ARCHIVED''']
  operational_restriction enum [note: '''NONE · OWNER_REVIEW_REQUIRED''']
  // constraint: ck_console_iff_playstation
  // constraint: uq_resource_name (venue_id, activity, name)
  // constraint: ix_resource_eligible WHERE base_state='ACTIVE' AND restriction='NONE'
}

Table resource_selling_block [headercolor: #16a34a, note: '''A STATE, scoped to one resource only — FR-OPS-15.'''] {
  id uuid [pk]
  resource_id uuid
  cause text
  emergency_id uuid
  active boolean
  started_at timestamptz
  ended_at timestamptz
}

Table resource_state_change [headercolor: #16a34a, note: '''APPEND-ONLY.'''] {
  id uuid [pk]
  resource_id uuid
  from_base_state enum
  to_base_state enum
  from_restriction enum
  to_restriction enum
  from_console enum
  to_console enum
  owner_password_used boolean
  actor_type text
  actor_id uuid
  reason text
  correlation_id uuid
}

// ===================== Pricing =====================
Table venue_default_price [headercolor: #65a30d, note: '''PlayStation = console x mode (4 rows). Billiards / ping pong = one hourly rate.'''] {
  id uuid [pk]
  venue_id uuid
  activity enum
  console_type enum [note: '''PlayStation only''']
  play_mode enum [note: '''SINGLE · MULTIPLAYER — PlayStation only''']
  hourly_price numeric(12,2)
  // constraint: ck_price_dimensions
  // constraint: ux_default_price
}

Table resource_price_override [headercolor: #65a30d, note: '''PlayStation rooms only. DELETED by a console change — FR-VEN-15.'''] {
  id uuid [pk]
  resource_id uuid
  console_type enum
  play_mode enum
  hourly_price numeric(12,2)
}

// ===================== Inventory core =====================
Table resource_reservation [headercolor: #dc2626, note: '''THE table. Layer 1 exclusive occupancy. Its exclusion constraint is invariant I1.'''] {
  id uuid [pk]
  resource_id uuid
  kind enum [note: '''BOOKING_PENDING · BOOKING_AWAITING_HOLD · BOOKING_CONFIRMED · BOOKING_ACTIVE · TOURNAMENT_APPROVAL_HOLD · TOURNAMENT_HOLD · MAINTENANCE''']
  booking_id uuid
  tournament_id uuid
  maintenance_id uuid
  planned_period tstzrange [note: '''IMMUTABLE — FR-AVL-13''']
  occupied_period tstzrange [note: '''the live occupancy; NULL once released''']
  actual_start timestamptz
  released_at timestamptz
  release_reason text
  // constraint: ex_no_double_booking  EXCLUDE USING gist (resource_id =, occupied_period &&) WHERE occupied_period IS NOT NULL
  // constraint: ck_owner_ref (exactly one owner reference)
  // constraint: ck_occupied_within_planned
}

Table venue_activity_availability [headercolor: #dc2626, note: '''PROJECTION. Advisory only — never read on a commit path (FR-AVL-11).'''] {
  venue_id uuid
  activity enum
  nearest_available_at timestamptz
  starting_price numeric(12,2)
  refreshed_at timestamptz
  indexes {
    (venue_id, activity) [pk]
  }
}

// ===================== Operations =====================
Table maintenance_window [headercolor: #ea580c, note: '''Layer 1: owns a resource_reservation row, so overlapping a booking is impossible.'''] {
  id uuid [pk]
  resource_id uuid
  period tstzrange
  reason text
  created_from_emergency_id uuid [note: '''counts toward the same rolling total''']
  owner_password_used boolean [note: '''required over 24h-in-48h — FR-OPS-03''']
}

Table venue_closure [headercolor: #ea580c, note: '''Layer 2 non-exclusive — a closure MAY overlap existing maintenance (FR-VEN-33).'''] {
  id uuid [pk]
  venue_id uuid
  period tstzrange
  kind text [note: '''FULL_DAY · PARTIAL''']
  reason text
}

Table emergency [headercolor: #ea580c, note: '''Layer 2. An unresolved emergency is NEVER an infinite reservation.'''] {
  id uuid [pk]
  scope enum [note: '''VENUE · RESOURCE''']
  venue_id uuid
  resource_id uuid
  status enum [note: '''ACTIVE · AWAITING_CONFIRMATION · ENDED · CONVERTED''']
  declared_at timestamptz [note: '''NOW only, never scheduled — FR-OPS-06''']
  expected_end_at timestamptz [note: '''mandatory, within the current session''']
  declared_period tstzrange [note: '''the cascade window''']
  reason text [note: '''mandatory''']
  converted_to text [note: '''CLOSURE · OPENING_HOURS_CHANGE · MAINTENANCE · DISABLED · ARCHIVED''']
  ended_at timestamptz
  // constraint: ck_emergency_scope
  // constraint: ck_conversion_target (a resource emergency may not become an hours change)
}

Table emergency_pause_record [headercolor: #ea580c, note: '''APPEND-ONLY. Immutable operational history — FR-OPS-41.'''] {
  id uuid [pk]
  booking_id uuid
  pause_kind text [note: '''VENUE_RESPONSE · LATE_CONFIRM''']
  pause_started_at timestamptz
  pause_ended_at timestamptz
  pause_cause text
  accumulated_duration interval
}

Table owner_review [headercolor: #ea580c] {
  id uuid [pk]
  resource_id uuid
  entered_at timestamptz
  entry_cause text
  resolved_at timestamptz
  resolution text [note: '''RETURN_TO_SERVICE · EXTEND_MAINTENANCE · DISABLE · ARCHIVE''']
  owner_password_used boolean
  correlation_id uuid
}

Table operational_interruption_record [headercolor: #ea580c, note: '''APPEND-ONLY.'''] {
  id uuid [pk]
  subject_type text [note: '''BOOKING · MANUAL_BOOKING · TOURNAMENT''']
  subject_id uuid
  cause text
  occurred_at timestamptz
  attendance_evidence jsonb
  refund_applied boolean
  correlation_id uuid
}

// ===================== Booking =====================
Table booking [headercolor: #d97706, note: '''Online and manual share one table. Status decides blocking; source never does.'''] {
  id uuid [pk]
  venue_id uuid
  resource_id uuid
  customer_id uuid [note: '''NULL allowed for MANUAL — FR-MAN-01''']
  source enum [note: '''ONLINE · MANUAL''']
  status enum [note: '''PENDING · VENUE_RESPONSE_EXPIRED · AWAITING_CUSTOMER_CONFIRMATION · CONFIRMED · ACTIVE · COMPLETED · REJECTED · CANCELLED · NO_SHOW''']
  activity enum [note: '''historical snapshot.''']
  console_type enum [note: '''historical snapshot. snapshot — survives a later console change''']
  play_mode enum [note: '''historical snapshot.''']
  resource_name_snapshot text [note: '''historical snapshot.''']
  start_at timestamptz
  end_at timestamptz [note: '''start + nominal minutes, real elapsed''']
  nominal_booked_minutes int [note: '''drives PRICE, never DST-adjusted''']
  venue_hourly_price numeric(12,2) [note: '''historical snapshot.''']
  venue_price_total numeric(12,2)
  booking_fee numeric(12,2) [note: '''historical snapshot. EGP 0 at launch, snapshot at creation''']
  total_amount numeric(12,2)
  business_date date [note: '''the revenue-day key — ALWAYS present''']
  operating_day date [note: '''NULL for manual outside published hours''']
  session_local_start timestamp [note: '''historical snapshot.''']
  session_local_end timestamp [note: '''historical snapshot.''']
  session_timezone text [note: '''historical snapshot.''']
  venue_response_expires_at timestamptz [note: '''persisted 10-minute deadline''']
  response_pause_started_at timestamptz
  cumulative_emergency_pause_duration interval [note: '''30-minute cap''']
  late_confirm_pause_started_at timestamptz
  cumulative_late_confirm_emergency_pause_duration interval [note: '''30-minute cap''']
  terminal_reason enum [note: '''exactly one when terminal''']
  terminal_at timestamptz [note: '''drives phone retention''']
  venue_reject_reason_text text [note: '''MANDATORY free text, separate from the code''']
  commitment_period tstzrange [note: '''GENERATED — non-null only while counted''']
  manual_customer_name text
  manual_customer_phone text
  // constraint: ck_terminal_reason
  // constraint: ck_duration (60-360, /30)
  // constraint: ck_manual_states
  // constraint: ex_customer_no_overlap EXCLUDE (customer_id =, commitment_period &&)
}

Table booking_history [headercolor: #d97706, note: '''APPEND-ONLY. Nothing is ever removed. 'Auto Cancelled' survives a Late Confirm revival.'''] {
  id uuid [pk]
  booking_id uuid
  sequence bigint [note: '''monotonic per booking''']
  occurred_at timestamptz
  entry_kind text [note: '''STATUS_TRANSITION · BOOKING_EVENT''']
  from_status enum
  to_status enum
  terminal_reason enum
  event_type enum [note: '''the 12 canonical booking events''']
  detail_code enum [note: '''ONLY with LATE_CONFIRM_ELIGIBILITY_LOST...''']
  actor_type text
  actor_id uuid
  correlation_id uuid
  // constraint: uq_history_seq
  // constraint: ck_entry_shape (reason codes and events never conflate)
  // constraint: ck_detail_code_scope
}

// ===================== Late Confirmation =====================
Table late_confirmation [headercolor: #ca8a04, note: '''Per-booking state — simultaneous Late Confirmations never interfere.'''] {
  id uuid [pk]
  booking_id uuid [note: '''SAME Booking ID — FR-LCF-08''']
  attempt_no smallint
  initiated_at timestamptz
  expires_at timestamptz [note: '''MIN(now + 5 min, booking.start_at)''']
  warning_sent_at timestamptz [note: '''only when the window > 60 s''']
  hold_reservation_id uuid
  customer_response text [note: '''ACCEPTED · DECLINED · TIMED_OUT''']
  responded_at timestamptz
  // constraint: uq_lc_attempt
  // constraint: ux_lc_open (one open per booking)
}

// ===================== Attendance =====================
Table attendance_record [headercolor: #7c3aed, note: '''Attendance Result is an INDEPENDENT stored field, never derived from booking status.'''] {
  id uuid [pk]
  booking_id uuid [note: '''UNIQUE''']
  result enum [note: '''ATTENDED · ATTENDANCE_UNCONFIRMED · ATTENDED_INTERRUPTED · ABSENT_NO_SHOW · NOT_APPLICABLE''']
  check_in_at timestamptz [note: '''[start, start+15m)''']
  check_in_reversed_at timestamptz [note: '''admin only''']
  late_present_at timestamptz [note: '''[start+15m, end)''']
  late_present_reversed_at timestamptz
  no_show_at timestamptz [note: '''[start+15m, end)''']
  no_show_reversed_at timestamptz
  recorded_by_venue_account_id uuid
  resolved_at timestamptz
  protection_applied boolean [note: '''at most one per booking''']
  // constraint: ck_late_present_blocks_noshow
}

Table account_access_restriction_interval [headercolor: #7c3aed, note: '''A booking may span several intervals; all are evaluated, ONE protection event emitted.'''] {
  id uuid [pk]
  booking_id uuid
  ordinal smallint
  disabled_at timestamptz
  reenabled_at timestamptz
  source text
  admin_id uuid
  reason text
  correlation_id uuid
}

Table attendance_protection_candidate [headercolor: #7c3aed] {
  id uuid [pk]
  booking_id uuid
  recorded_at timestamptz [note: '''at disable time — the EVENT comes at resolution''']
  audit_context jsonb
}

// ===================== Tournament =====================
Table tournament [headercolor: #c026d3, note: '''A separate entity from a booking — never modelled as one.'''] {
  id uuid [pk]
  venue_id uuid
  host_type text [note: '''PLAYER · VENUE''']
  creator_user_id uuid [note: '''NOT NULL when PLAYER''']
  creator_participates boolean
  activity enum
  play_mode enum [note: '''PlayStation only''']
  status enum [note: '''PENDING_VENUE_APPROVAL · WAITING_FOR_PLAYERS · CONFIRMED · ACTIVE · COMPLETED · REJECTED · CANCELLED''']
  capacity smallint [note: '''8-32''']
  start_at timestamptz
  end_at timestamptz
  nominal_minutes int [note: '''>= 60, /30''']
  checkpoint_at timestamptz [note: '''EXACTLY start - 1h''']
  approval_expires_at timestamptz [note: '''MIN(created + 10m, checkpoint)''']
  visibility text [note: '''PUBLIC · PRIVATE''']
  invite_code text [unique, note: '''inactive while PENDING_VENUE_APPROVAL''']
  venue_cost_total numeric(12,2) [note: '''historical snapshot. never changed by resource loss''']
  entry_fee numeric(12,2) [note: '''INFORMATIONAL ONLY''']
  prize numeric(12,2) [note: '''INFORMATIONAL ONLY''']
  business_date date [note: '''revenue only on COMPLETED''']
  terminal_reason enum [note: '''exactly one of 12''']
  // constraint: ck_checkpoint (= start - 1h)
  // constraint: ck_t_terminal
  // constraint: ux_one_pending_request (creator) WHERE PLAYER + PENDING_VENUE_APPROVAL
}

Table tournament_resource [headercolor: #c026d3, note: '''1 to 4 rows. Removal never changes the stored cost.'''] {
  id uuid [pk]
  tournament_id uuid
  resource_id uuid
  hourly_price_snapshot numeric(12,2) [note: '''historical snapshot.''']
  reservation_id uuid
  removed_at timestamptz
  removal_cause text
}

Table tournament_participant [headercolor: #c026d3, note: '''Historical participation is always retained.'''] {
  id uuid [pk]
  tournament_id uuid
  user_id uuid
  status enum [note: '''JOINED · LEFT · REMOVED · INELIGIBLE''']
  joined_at timestamptz
  left_at timestamptz
  removed_at timestamptz
  ineligible_reason text
  // constraint: UNIQUE (tournament_id, user_id)
}

Table tournament_history [headercolor: #c026d3, note: '''APPEND-ONLY.'''] {
  id uuid [pk]
  tournament_id uuid
  sequence bigint
  occurred_at timestamptz
  from_status enum
  to_status enum
  terminal_reason enum
  actor_type text
  actor_id uuid
  correlation_id uuid
}

// ===================== Trust =====================
Table trust_input_event [headercolor: #be123c, note: '''APPEND-ONLY. THE authority. Everything about trust is replayed from here, ordered by (effective_at, event_sequence).'''] {
  id uuid [pk]
  event_type enum [note: '''11 closed members — FR-TRS-02''']
  subject_user_id uuid
  occurred_at timestamptz
  effective_at timestamptz [note: '''closed rules — booking.startAt, or the corrected event's''']
  event_sequence bigint [unique, note: '''global monotonic''']
  booking_id uuid
  target_event_id uuid [note: '''the event this one corrects''']
  corrected_outcome enum [note: '''mandatory on ATTENDANCE_CORRECTED''']
  payload jsonb
  // constraint: uq_trust_seq
  // constraint: ck_corrected_outcome
  // constraint: ux_one_protection_per_booking
  // constraint: ix_trust_replay (subject, effective_at, event_sequence)
}

Table user_trust_state [headercolor: #be123c, note: '''DERIVED PROJECTION — never authoritative (FR-TRS-01). Rebuildable by replay.'''] {
  user_id uuid [pk]
  consecutive_no_shows int
  penalty_stage smallint
  current_threshold smallint
  completed_attended_count int [note: '''Verified Player progress''']
  vp_qualification enum [note: '''NOT_QUALIFIED · QUALIFIED''']
  vp_operational_status enum [note: '''NOT_VERIFIED · VERIFIED · SUSPENDED · REVOKED''']
  last_replayed_event_sequence bigint
  recomputed_at timestamptz
}

Table ban_qualification [headercolor: #be123c, note: '''Historical and derived. Distinct from a ban instance — FR-TRS-17.'''] {
  id uuid [pk]
  user_id uuid
  qualification_at timestamptz [note: '''HISTORICAL — when history says the threshold was crossed''']
  penalty_stage smallint
  triggering_event_id uuid
}

Table ban_instance [headercolor: #be123c, note: '''Operational. At most one ACTIVE per user; a further qualification EXTENDS it.'''] {
  id uuid [pk]
  user_id uuid
  qualification_id uuid
  penalty_stage smallint
  activated_at timestamptz [note: '''NOW — never back-dated''']
  ends_at timestamptz [note: '''always activated_at + duration''']
  duration interval
  status enum [note: '''ACTIVE · EXPIRED · LIFTED · CORRECTED''']
  activation_reason text
  cascade_executed_at timestamptz [note: '''IDEMPOTENCY KEY — cascade runs once only''']
  // constraint: ux_one_active_ban (user_id) WHERE status='ACTIVE'
}

Table verified_player_transition [headercolor: #be123c] {
  id uuid [pk]
  user_id uuid
  transition_id uuid [unique, note: '''IDEMPOTENCY KEY for the tournament cascade''']
  from_status enum
  to_status enum
  occurred_at timestamptz
  cause text [note: '''TRUST_CORRECTION vs ADMIN decides auto-restore eligibility''']
  admin_id uuid
  cascade_executed_at timestamptz
}

// ===================== Loyalty =====================
Table points_account [headercolor: #0369a1] {
  user_id uuid [pk]
  balance integer [note: '''CHECK >= 0 — never negative''']
}

Table points_transaction [headercolor: #0369a1, note: '''APPEND-ONLY.'''] {
  id uuid [pk]
  points_account_id uuid
  amount integer [note: '''signed''']
  cause text [note: '''ATTENDED_COMPLETION · REFERRAL_SIGNUP · COMPENSATION · ADMIN''']
  booking_id uuid
  referral_id uuid
  granted_value_snapshot integer [note: '''historical snapshot. the configured value AT the moment''']
  compensates_transaction_id uuid
  unrecovered_reversal_amount integer [note: '''never debt, never auto-repaid''']
  admin_id uuid
  reason text
  // constraint: ux_points_booking_reward
  // constraint: ux_points_referral_reward
}

Table wallet_account [headercolor: #0369a1, note: '''Ledger exists; NO customer screen at launch — FR-PTS-11.'''] {
  user_id uuid [pk]
  balance numeric(12,2) [note: '''EGP 0''']
}

Table wallet_transaction [headercolor: #0369a1, note: '''APPEND-ONLY. Never pays the venue gaming charge.'''] {
  id uuid [pk]
  wallet_account_id uuid
  amount numeric(12,2)
  cause text
  booking_id uuid
  occurred_at timestamptz
}

Table referral [headercolor: #0369a1] {
  id uuid [pk]
  referrer_user_id uuid
  referred_user_id uuid [note: '''UNIQUE — one reward per referred user''']
  code text
  status enum [note: '''PENDING · REWARDED · INVALID''']
  reward_value_applied integer [note: '''historical snapshot. read AT OTP verification''']
  rewarded_at timestamptz
  invalidated_at timestamptz
  fraud_signals jsonb [note: '''device/IP are signals, never hard blocks''']
  // constraint: ck_no_self_referral
}

Table booking_fee_refund [headercolor: #0369a1] {
  id uuid [pk]
  booking_id uuid
  treatment enum [note: '''FULL · CUSTOMER_POLICY · NOT_APPLICABLE''']
  amount numeric(12,2)
  terminal_reason enum [note: '''every reachable reason maps to exactly one treatment''']
  occurred_at timestamptz
}

// ===================== Reviews =====================
Table review [headercolor: #475569, note: '''No completed booking required. Only ACTIVE counts toward the rating.'''] {
  id uuid [pk]
  user_id uuid
  venue_id uuid
  rating smallint [note: '''1-5''']
  comment text
  status enum [note: '''PENDING_MODERATION · ACTIVE · HIDDEN · REMOVED (terminal)''']
  author_deleted_at timestamptz
  // constraint: ux_review_current (user_id, venue_id)
}

Table review_moderation_event [headercolor: #475569, note: '''APPEND-ONLY.'''] {
  id uuid [pk]
  review_id uuid
  action text [note: '''APPROVE · HIDE · RESTORE · REMOVE''']
  previous_status enum
  new_status enum
  admin_id uuid
  reason text
}

Table review_cooldown [headercolor: #475569] {
  id uuid [pk]
  user_id uuid
  venue_id uuid
  removed_at timestamptz
  cooldown_until timestamptz [note: '''30 days''']
}

Table venue_rating_stats [headercolor: #475569, note: '''PROJECTION — rebuildable.'''] {
  venue_id uuid [pk]
  average_rating numeric(3,2)
  review_count int
  distribution_1 int
  distribution_2 int
  distribution_3 int
  distribution_4 int
  distribution_5 int
}

// ===================== Notifications =====================
Table notification [headercolor: #4f46e5] {
  id uuid [pk]
  recipient_type text [note: '''CUSTOMER · VENUE · ADMIN''']
  recipient_id uuid
  code text [note: '''LANGUAGE-NEUTRAL template code''']
  booking_id uuid [note: '''every booking notification carries it''']
  tournament_id uuid
  params jsonb
  read_at timestamptz
}

Table notification_delivery [headercolor: #4f46e5] {
  id uuid [pk]
  notification_id uuid
  channel text [note: '''IN_APP · PUSH · EMAIL · SMS (OTP only)''']
  status text [note: '''PENDING · SENT · FAILED · DEAD_LETTER''']
  attempt smallint
  provider_message_id text
  error_code text
  last_attempt_at timestamptz
  // constraint: ux_delivery_once (notification_id, channel)
}

Table device_token [headercolor: #4f46e5] {
  id uuid [pk]
  user_id uuid
  token text [unique]
  platform text [note: '''IOS · ANDROID · WEB''']
  last_seen_at timestamptz
}

// ===================== Configuration =====================
Table platform_config [headercolor: #78716c, note: '''Booking fee, tournament fee, points, referral reward, VP requirement. NOT the no-show ladder.'''] {
  key text [pk]
  value jsonb
  updated_at timestamptz
}

Table platform_config_history [headercolor: #78716c, note: '''APPEND-ONLY.'''] {
  id uuid [pk]
  key text
  old_value jsonb
  new_value jsonb
  effective_from timestamptz [note: '''FUTURE EVENTS ONLY''']
  admin_id uuid
  reason text
}

// ===================== Audit =====================
Table audit_event [headercolor: #57534e, note: '''APPEND-ONLY.'''] {
  id uuid [pk]
  occurred_at timestamptz
  actor_type text [note: '''CUSTOMER · VENUE · ADMIN · SYSTEM''']
  actor_id uuid
  action text
  subject_type text
  subject_id uuid
  reason text [note: '''mandatory where the action requires one''']
  owner_password_used boolean
  owner_password_outcome text [note: '''SUCCESS · FAILURE — both audited''']
  correlation_id uuid [note: '''traces a whole cascade''']
  payload jsonb [note: '''redaction-allowlisted — NEVER a secret''']
}

// ===================== Platform Admin =====================
Table admin_account [headercolor: #334155] {
  id uuid [pk]
  email citext [unique]
  password_hash text
  full_name text
  is_active boolean
}

Table admin_alert [headercolor: #334155, note: '''Abuse signals write here ONLY — never into Trust, Venue status or Booking.'''] {
  id uuid [pk]
  kind text
  severity text
  subject_type text
  subject_id uuid
  payload jsonb
  acknowledged_at timestamptz
  correlation_id uuid
}

// ===================== Technical =====================
Table scheduled_transition [headercolor: #64748b, note: '''FOR UPDATE SKIP LOCKED leases. Late firing never changes the outcome.'''] {
  id uuid [pk]
  type text [note: '''VENUE_RESPONSE_EXPIRY · LATE_CONFIRM_EXPIRY · BOOKING_START · ...''']
  subject_id uuid
  due_at timestamptz [note: '''persisted — never computed at read time''']
  state text [note: '''PENDING · PAUSED · LEASED · DONE · SUPERSEDED · FAILED''']
  attempt smallint
  leased_until timestamptz
  leased_by text
  idempotency_key text [unique]
  last_error text
}

Table outbox_event [headercolor: #64748b, note: '''Written in the business transaction. Notifications dispatch ONLY after commit.'''] {
  id bigserial [pk]
  event_type text
  aggregate_type text
  aggregate_id uuid
  payload jsonb
  correlation_id uuid
  state text [note: '''PENDING · DISPATCHED · DEAD_LETTER''']
  attempt smallint
  next_attempt_at timestamptz
  dispatched_at timestamptz
}

Table idempotency_record [headercolor: #64748b] {
  idempotency_key text
  endpoint text
  principal_id uuid
  request_fingerprint text
  response_status smallint
  response_body jsonb
  indexes {
    (idempotency_key, endpoint, principal_id) [pk]
  }
}

// ===================== relationships =====================
Ref: otp_challenge.user_id > user_account.id
Ref: auth_refresh_token.rotated_to > auth_refresh_token.id
Ref: username_change.user_id > user_account.id
Ref: account_anonymisation.user_id > user_account.id
Ref: account_anonymisation.admin_id > admin_account.id
Ref: venue.area_id > area.id
Ref: venue_account.venue_id > venue.id
Ref: venue_image.venue_id > venue.id
Ref: venue_activity.venue_id > venue.id
Ref: venue_opening_template.venue_id > venue.id
Ref: venue_opening_day.venue_id > venue.id
Ref: venue_operating_session.venue_id > venue.id
Ref: venue_selling_block.venue_id > venue.id
Ref: venue_selling_block.emergency_id > emergency.id
Ref: resource.venue_id > venue.id
Ref: resource_selling_block.resource_id > resource.id
Ref: resource_selling_block.emergency_id > emergency.id
Ref: resource_state_change.resource_id > resource.id
Ref: venue_default_price.venue_id > venue.id
Ref: resource_price_override.resource_id > resource.id
Ref: resource_reservation.resource_id > resource.id
Ref: resource_reservation.booking_id > booking.id
Ref: resource_reservation.tournament_id > tournament.id
Ref: resource_reservation.maintenance_id > maintenance_window.id
Ref: maintenance_window.resource_id > resource.id
Ref: maintenance_window.created_from_emergency_id > emergency.id
Ref: venue_closure.venue_id > venue.id
Ref: emergency.venue_id > venue.id
Ref: emergency.resource_id > resource.id
Ref: emergency_pause_record.booking_id > booking.id
Ref: owner_review.resource_id > resource.id
Ref: booking.venue_id > venue.id
Ref: booking.resource_id > resource.id
Ref: booking.customer_id > user_account.id
Ref: booking_history.booking_id > booking.id
Ref: late_confirmation.booking_id > booking.id
Ref: late_confirmation.hold_reservation_id > resource_reservation.id
Ref: attendance_record.booking_id > booking.id
Ref: attendance_record.recorded_by_venue_account_id > venue_account.id
Ref: account_access_restriction_interval.booking_id > booking.id
Ref: account_access_restriction_interval.admin_id > admin_account.id
Ref: attendance_protection_candidate.booking_id > booking.id
Ref: tournament.venue_id > venue.id
Ref: tournament.creator_user_id > user_account.id
Ref: tournament_resource.tournament_id > tournament.id
Ref: tournament_resource.resource_id > resource.id
Ref: tournament_resource.reservation_id > resource_reservation.id
Ref: tournament_participant.tournament_id > tournament.id
Ref: tournament_participant.user_id > user_account.id
Ref: tournament_history.tournament_id > tournament.id
Ref: trust_input_event.subject_user_id > user_account.id
Ref: trust_input_event.booking_id > booking.id
Ref: trust_input_event.target_event_id > trust_input_event.id
Ref: ban_qualification.user_id > user_account.id
Ref: ban_qualification.triggering_event_id > trust_input_event.id
Ref: ban_instance.user_id > user_account.id
Ref: ban_instance.qualification_id > ban_qualification.id
Ref: verified_player_transition.user_id > user_account.id
Ref: verified_player_transition.admin_id > admin_account.id
Ref: points_transaction.points_account_id > points_account.user_id
Ref: points_transaction.booking_id > booking.id
Ref: points_transaction.referral_id > referral.id
Ref: points_transaction.compensates_transaction_id > points_transaction.id
Ref: points_transaction.admin_id > admin_account.id
Ref: wallet_transaction.wallet_account_id > wallet_account.user_id
Ref: wallet_transaction.booking_id > booking.id
Ref: referral.referrer_user_id > user_account.id
Ref: referral.referred_user_id > user_account.id
Ref: booking_fee_refund.booking_id > booking.id
Ref: review.user_id > user_account.id
Ref: review.venue_id > venue.id
Ref: review_moderation_event.review_id > review.id
Ref: review_moderation_event.admin_id > admin_account.id
Ref: review_cooldown.user_id > user_account.id
Ref: review_cooldown.venue_id > venue.id
Ref: notification.booking_id > booking.id
Ref: notification.tournament_id > tournament.id
Ref: notification_delivery.notification_id > notification.id
Ref: device_token.user_id > user_account.id
Ref: platform_config_history.admin_id > admin_account.id