<table name="configuration_version" layers="0" collapse-mode="2" max-obj-count="12" z-value="0">
	<schema name="config"/>
	<role name="postgres"/>
	<comment> <![CDATA[APPEND-ONLY version history (no UPDATE/DELETE/TRUNCATE). Written only by config.change_configuration / loyalty.configure inside a trusted Admin command. version_position is DB-generated and totally orders history; (key, effective_from) is unique. Future-only: effective_from = changed_at = server command time; the single exception is the initial technical bootstrap (effective_from = -infinity, no Admin).]]> </comment>
	<position x="6580" y="9400"/>
	<column name="id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="key" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="old_value">
		<type name="jsonb" length="0"/>
	</column>
	<column name="new_value" not-null="true">
		<type name="jsonb" length="0"/>
	</column>
	<column name="effective_from" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[FUTURE EVENTS ONLY]]> </comment>
	</column>
	<column name="admin_id">
		<type name="uuid" length="0"/>
	</column>
	<column name="reason">
		<type name="text" length="0"/>
	</column>
	<column name="changed_at" not-null="true" default-value="clock_timestamp()">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="correlation_id" not-null="true" default-value="gen_random_uuid()">
		<type name="uuid" length="0"/>
	</column>
	<column name="version_position" not-null="true"
	 identity-type="ALWAYS">
		<type name="bigint" length="0"/>
	</column>
	<constraint name="configuration_version_pk" type="pk-constr" table="config.configuration_version">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_config_future_only" type="ck-constr" table="config.configuration_version">
			<expression> <![CDATA[effective_from = changed_at OR (effective_from = '-infinity'::timestamptz AND admin_id IS NULL)]]> </expression>
	</constraint>
	<constraint name="ck_config_reason" type="ck-constr" table="config.configuration_version">
			<expression> <![CDATA[reason IS NOT NULL AND length(btrim(reason)) > 0]]> </expression>
	</constraint>
	<constraint name="uq_config_version_position" type="uq-constr" table="config.configuration_version">
		<columns names="version_position" ref-type="src-columns"/>
	</constraint>
</table>

<table name="configuration_key" layers="0" collapse-mode="2" max-obj-count="10" z-value="0">
	<schema name="config"/>
	<role name="postgres"/>
	<comment> <![CDATA[TECHNICAL configuration registry: type, range, units and allowed values per key. Registration is a deployment operation (append-only). Every configuration_version / system_configuration value must validate against its key's registry row; unregistered keys are rejected. No Product rule is introduced here - entries restate documented values/ranges only.]]> </comment>
	<position x="7360" y="9920"/>
	<column name="key" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="value_type" not-null="true">
		<type name="text" length="0"/>
		<comment> <![CDATA[INTEGER · NUMERIC · BOOLEAN · TEXT]]> </comment>
	</column>
	<column name="min_value">
		<type name="numeric" length="0"/>
	</column>
	<column name="max_value">
		<type name="numeric" length="0"/>
	</column>
	<column name="units">
		<type name="text" length="0"/>
	</column>
	<column name="allowed_values">
		<type name="jsonb" length="0"/>
		<comment> <![CDATA[JSON array of permitted values, or NULL]]> </comment>
	</column>
	<column name="owner_module" not-null="true">
		<type name="text" length="0"/>
		<comment> <![CDATA[Module whose producer writes the key (e.g. loyalty, platform)]]> </comment>
	</column>
	<column name="source_reference" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="registered_at" not-null="true" default-value="clock_timestamp()">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<constraint name="configuration_key_pk" type="pk-constr" table="config.configuration_key">
		<columns names="key" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_configuration_key_values" type="ck-constr" table="config.configuration_key">
			<expression> <![CDATA[key ~ '^[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*)*$' AND value_type IN ('INTEGER','NUMERIC','BOOLEAN','TEXT') AND (min_value IS NULL OR max_value IS NULL OR min_value <= max_value) AND (value_type IN ('INTEGER','NUMERIC') OR (min_value IS NULL AND max_value IS NULL)) AND (allowed_values IS NULL OR (jsonb_typeof(allowed_values) = 'array' AND jsonb_array_length(allowed_values) > 0)) AND length(btrim(owner_module)) > 0 AND length(btrim(source_reference)) > 0]]> </expression>
	</constraint>
</table>

