		<comment> <![CDATA[CUSTOMER · VENUE · ADMIN · SYSTEM]]> </comment>
	</column>
	<column name="actor_id">
		<type name="uuid" length="0"/>
	</column>
	<column name="action" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="subject_type" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="subject_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="reason">
		<type name="text" length="0"/>
		<comment> <![CDATA[mandatory where the action requires one]]> </comment>
	</column>
