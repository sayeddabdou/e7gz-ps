		<comment> <![CDATA[Default schedule local end; <= open means cross-midnight.]]> </comment>
	</column>
	<column name="default_full_day" not-null="true" default-value="false">
		<type name="boolean" length="0"/>
		<comment> <![CDATA[Explicit 24-hour local-wall-clock template.]]> </comment>
	</column>
