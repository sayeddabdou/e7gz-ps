	</column>
	<column name="qualification_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="penalty_stage" not-null="true">
		<type name="smallint" length="0"/>
	</column>
	<column name="activated_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[NOW — never back-dated]]> </comment>
	</column>
	<column name="ends_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[always activated_at + duration]]> </comment>
	</column>
	<column name="duration" not-null="true">
		<type name="interval" length="0"/>
	</column>
	<column name="status" not-null="true">
		<type name="varchar" length="80"/>
		<comment> <![CDATA[ACTIVE · EXPIRED · LIFTED · CORRECTED]]> </comment>
	</column>
	<column name="activation_reason" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="cascade_executed_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[IDEMPOTENCY KEY — cascade runs once only]]> </comment>
	</column>
	<column name="latest_qualification_id" not-null="true">
		<type name="uuid" length="0"/>
		<comment> <![CDATA[Latest consumed qualification. Initial qualification_id remains immutable.]]> </comment>
	</column>
	<column name="last_command_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[DB-owned post-lock command instant for the latest Ban lifecycle command.]]> </comment>
	</column>
	<column name="cascade_targets_registered_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[Equals activated_at once the exact Booking and reservation target sets are captured.]]> </comment>
	</column>
	<constraint name="ban_instance_pk" type="pk-constr" table="trust.ban_instance">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_ban_instance_status" type="ck-constr" table="trust.ban_instance">
			<expression> <![CDATA[status IN ('ACTIVE','EXPIRED','LIFTED','CORRECTED')]]> </expression>
	</constraint>
	<constraint name="ck_ban_instance_stage" type="ck-constr" table="trust.ban_instance">
			<expression> <![CDATA[penalty_stage >= 0]]> </expression>
	</constraint>
	<constraint name="ck_ban_instance_time_arithmetic" type="ck-constr" table="trust.ban_instance">
			<expression> <![CDATA[duration > interval '0' AND ends_at > activated_at AND ends_at = activated_at + duration]]> </expression>
	</constraint>
	<constraint name="ck_ban_instance_activation_reason" type="ck-constr" table="trust.ban_instance">
			<expression> <![CDATA[length(btrim(activation_reason)) > 0]]> </expression>
	</constraint>
</table>

