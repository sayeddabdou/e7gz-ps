	<column name="id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="tournament_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="resource_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="console_type_snapshot">
		<type name="text" length="0"/>
		<comment> <![CDATA[PS4/PS5 snapshot where Activity=PLAYSTATION.]]> </comment>
	</column>
	<column name="hourly_price_snapshot" not-null="true">
		<type name="numeric" length="12" precision="2"/>
		<comment> <![CDATA[historical snapshot.]]> </comment>
	</column>
	<column name="reservation_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="removed_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="removal_cause">
		<type name="text" length="0"/>
	</column>
	<constraint name="tournament_resource_pk" type="pk-constr" table="tournament.tournament_resource">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="uq_tournament_resource" type="uq-constr" table="tournament.tournament_resource">
		<columns names="tournament_id,resource_id" ref-type="src-columns"/>
	</constraint>
	<constraint name="uq_tournament_reservation" type="uq-constr" table="tournament.tournament_resource">
		<columns names="reservation_id" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_tournament_resource_console_snapshot" type="ck-constr" table="tournament.tournament_resource">
			<expression> <![CDATA[console_type_snapshot IS NULL OR console_type_snapshot IN ('PS4','PS5')]]> </expression>
	</constraint>
	<constraint name="ck_tournament_resource_price_nonnegative" type="ck-constr" table="tournament.tournament_resource">
			<expression> <![CDATA[hourly_price_snapshot >= 0]]> </expression>
	</constraint>
	<constraint name="ck_tournament_resource_removal_shape" type="ck-constr" table="tournament.tournament_resource">
			<expression> <![CDATA[(removed_at IS NULL AND removal_cause IS NULL) OR (removed_at IS NOT NULL AND removal_cause IN ('RESOURCE_EMERGENCY_OUTAGE','RESOURCE_OWNER_REVIEW_REQUIRED'))]]> </expression>
	</constraint>
</table>

<table name="tournament_participant" layers="0" collapse-mode="2" max-obj-count="10" z-value="0">
	<schema name="tournament"/>
	<role name="postgres"/>
	<comment> <![CDATA[Historical participation is always retained. v1.1.11 records every participant state transition in append-only audit evidence; status_changed_at is the current-state transition timestamp and does not replace audit history. UNIQUE (tournament_id, user_id) remains canonical.]]> </comment>
	<position x="1760" y="7100"/>
	<column name="id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="tournament_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="user_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="status" not-null="true">
		<type name="varchar" length="80"/>
		<comment> <![CDATA[JOINED · LEFT · REMOVED · INELIGIBLE]]> </comment>
	</column>
	<column name="joined_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="status_changed_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[Current participant-state transition timestamp; full transition history is retained in append-only audit_event.]]> </comment>
	</column>
	<column name="left_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="removed_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="ineligible_reason">
		<type name="text" length="0"/>
	</column>
	<constraint name="tournament_participant_pk" type="pk-constr" table="tournament.tournament_participant">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="uq_tournament_participant" type="uq-constr" table="tournament.tournament_participant">
		<columns names="tournament_id,user_id" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_tournament_participant_status" type="ck-constr" table="tournament.tournament_participant">
			<expression> <![CDATA[status IN ('JOINED','LEFT','REMOVED','INELIGIBLE')]]> </expression>
	</constraint>
	<constraint name="ck_tournament_participant_timestamps" type="ck-constr" table="tournament.tournament_participant">
			<expression> <![CDATA[status_changed_at >= joined_at AND (left_at IS NULL OR left_at >= joined_at) AND (removed_at IS NULL OR removed_at >= joined_at)]]> </expression>
	</constraint>
	<constraint name="ck_tournament_participant_ineligible_reason" type="ck-constr" table="tournament.tournament_participant">
			<expression> <![CDATA[ineligible_reason IS NULL OR ineligible_reason IN ('BAN','ACCOUNT_DELETED')]]> </expression>
	</constraint>
	<constraint name="ck_tournament_participant_cause_shape" type="ck-constr" table="tournament.tournament_participant">
			<expression> <![CDATA[(status = 'INELIGIBLE') = (ineligible_reason IS NOT NULL)]]> </expression>
	</constraint>
</table>

