<table name="reward_application" layers="0" collapse-mode="2" max-obj-count="20" z-value="0">
	<schema name="loyalty"/>
	<role name="postgres"/>
	<comment> <![CDATA[Append-only reward reconciliation. One canonical source effect, one application. Zero-effect source changes are retained without inventing a monetary movement. The latest application is validated against current source eligibility.]]> </comment>
	<position x="8340" y="7160"/>
	<column name="id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="application_sequence" not-null="true">
		<type name="bigint" length="0"/>
	</column>
	<column name="source_kind" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="booking_id">
		<type name="uuid" length="0"/>
	</column>
	<column name="referral_id">
		<type name="uuid" length="0"/>
	</column>
	<column name="source_event_id">
		<type name="uuid" length="0"/>
	</column>
	<column name="user_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="operation_key" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="previous_application_id">
		<type name="uuid" length="0"/>
	</column>
	<column name="entitlement_before" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<column name="entitlement_after" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<column name="reward_value" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<column name="configuration_as_of" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="configuration_version_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="points_transaction_id">
		<type name="uuid" length="0"/>
	</column>
	<column name="applied_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="correlation_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<constraint name="reward_application_pk" type="pk-constr" table="loyalty.reward_application">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_reward_application_source" type="ck-constr" table="loyalty.reward_application">
			<expression> <![CDATA[(source_kind='BOOKING' AND booking_id IS NOT NULL AND referral_id IS NULL AND source_event_id IS NOT NULL) OR (source_kind='REFERRAL' AND referral_id IS NOT NULL AND booking_id IS NULL AND source_event_id IS NULL)]]> </expression>
	</constraint>
	<constraint name="ck_reward_application_entitlement" type="ck-constr" table="loyalty.reward_application">
			<expression> <![CDATA[reward_value>=0 AND entitlement_before IN (0,reward_value) AND entitlement_after IN (0,reward_value)]]> </expression>
	</constraint>
	<constraint name="uq_reward_app_operation" type="uq-constr" table="loyalty.reward_application">
		<columns names="operation_key" ref-type="src-columns"/>
	</constraint>
	<constraint name="uq_reward_app_sequence" type="uq-constr" table="loyalty.reward_application">
		<columns names="application_sequence" ref-type="src-columns"/>
	</constraint>
	<constraint name="uq_reward_app_tx" type="uq-constr" table="loyalty.reward_application">
		<columns names="points_transaction_id" ref-type="src-columns"/>
	</constraint>
	<constraint name="uq_reward_app_predecessor" type="uq-constr" table="loyalty.reward_application">
		<columns names="previous_application_id" ref-type="src-columns"/>
	</constraint>
</table>

<table name="booking_fee_receipt" layers="0" collapse-mode="2" max-obj-count="13" z-value="0">
	<schema name="loyalty"/>
	<role name="postgres"/>
	<comment> <![CDATA[Immutable confirmation of collected E7GZ Booking Fee from a trusted payment adapter. A fee snapshot is not proof of collection. No provider or customer funding integration is activated by this schema.]]> </comment>
	<position x="8340" y="8040"/>
	<column name="id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="booking_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="user_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="amount" not-null="true">
		<type name="numeric" length="12" precision="2"/>
	</column>
	<column name="currency" not-null="true" default-value="'EGP'">
		<type name="text" length="0"/>
	</column>
	<column name="provider" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="provider_reference" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="provider_occurred_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="received_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="correlation_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="audit_event_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<constraint name="booking_fee_receipt_pk" type="pk-constr" table="loyalty.booking_fee_receipt">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_fee_receipt_amount" type="ck-constr" table="loyalty.booking_fee_receipt">
			<expression> <![CDATA[amount>0 AND amount<>'NaN'::numeric AND currency='EGP' AND NULLIF(btrim(provider),'') IS NOT NULL AND NULLIF(btrim(provider_reference),'') IS NOT NULL AND provider_occurred_at<=received_at]]> </expression>
	</constraint>
	<constraint name="uq_fee_receipt_booking" type="uq-constr" table="loyalty.booking_fee_receipt">
		<columns names="booking_id" ref-type="src-columns"/>
	</constraint>
	<constraint name="uq_fee_receipt_provider" type="uq-constr" table="loyalty.booking_fee_receipt">
		<columns names="provider,provider_reference" ref-type="src-columns"/>
	</constraint>
</table>

