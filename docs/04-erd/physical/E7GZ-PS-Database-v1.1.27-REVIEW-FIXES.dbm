		<comment> <![CDATA[BOOKING · TOURNAMENT · NONE]]> </comment>
	</column>
	<column name="recipient_types" not-null="true">
		<type name="text" length="0" dimension="1"/>
	</column>
	<column name="required_channels" not-null="true">
		<type name="text" length="0" dimension="1"/>
	</column>
	<column name="allowed_channels" not-null="true">
		<type name="text" length="0" dimension="1"/>
	</column>
	<column name="otp_only" not-null="true" default-value="false">
		<type name="boolean" length="0"/>
	</column>
