<table name="venue_rating_stats" layers="0" collapse-mode="2" max-obj-count="10" z-value="0">
	<schema name="review"/>
	<role name="postgres"/>
	<comment> <![CDATA[PROJECTION - rebuildable ONLY by review.refresh_venue_rating() from review.review WHERE status = ACTIVE; a deferred check re-derives it at commit. average_rating is NULL exactly when review_count = 0.]]> </comment>
	<position x="200" y="9800"/>
	<column name="venue_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="average_rating">
		<type name="numeric" length="3" precision="2"/>
	</column>
	<column name="review_count" not-null="true" default-value="0">
		<type name="integer" length="0"/>
	</column>
	<column name="distribution_1" not-null="true" default-value="0">
		<type name="integer" length="0"/>
	</column>
	<column name="distribution_2" not-null="true" default-value="0">
		<type name="integer" length="0"/>
	</column>
	<column name="distribution_3" not-null="true" default-value="0">
		<type name="integer" length="0"/>
	</column>
	<column name="distribution_4" not-null="true" default-value="0">
		<type name="integer" length="0"/>
	</column>
	<column name="distribution_5" not-null="true" default-value="0">
		<type name="integer" length="0"/>
	</column>
	<column name="updated_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<constraint name="venue_rating_stats_pk" type="pk-constr" table="review.venue_rating_stats">
		<columns names="venue_id" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_rating_stats_counts" type="ck-constr" table="review.venue_rating_stats">
			<expression> <![CDATA[review_count >= 0 AND distribution_1 >= 0 AND distribution_2 >= 0 AND distribution_3 >= 0 AND distribution_4 >= 0 AND distribution_5 >= 0 AND distribution_1 + distribution_2 + distribution_3 + distribution_4 + distribution_5 = review_count]]> </expression>
	</constraint>
	<constraint name="ck_rating_stats_average" type="ck-constr" table="review.venue_rating_stats">
			<expression> <![CDATA[(review_count = 0 AND average_rating IS NULL) OR (review_count > 0 AND average_rating IS NOT NULL AND average_rating BETWEEN 1 AND 5)]]> </expression>
	</constraint>
</table>

