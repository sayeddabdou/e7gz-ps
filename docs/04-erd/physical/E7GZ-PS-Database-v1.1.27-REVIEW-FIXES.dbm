	</column>
	<column name="occurred_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="entry_kind" not-null="true">
		<type name="text" length="0"/>
		<comment> <![CDATA[STATUS_TRANSITION · BOOKING_EVENT]]> </comment>
	</column>
