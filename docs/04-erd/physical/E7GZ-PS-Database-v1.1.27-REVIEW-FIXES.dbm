<table name="otp_challenge" layers="0" collapse-mode="2" max-obj-count="14" z-value="0">
	<schema name="iam"/>
	<role name="postgres"/>
	<comment> <![CDATA[Rate limiting and audit share one row.

Source/critical constraints:
- ux_otp_active (destination, purpose)]]> </comment>
	<position x="1760" y="480"/>
	<column name="id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="user_id">
		<type name="uuid" length="0"/>
		<comment> <![CDATA[nullable — a destination may be challenged pre-account]]> </comment>
	</column>
	<column name="purpose" not-null="true">
		<type name="text" length="0"/>
		<comment> <![CDATA[PHONE_VERIFICATION · PASSWORD_RESET · PHONE_CHANGE]]> </comment>
	</column>
	<column name="destination" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="code_hash" not-null="true">
		<type name="text" length="0"/>
		<comment> <![CDATA[never stored in clear]]> </comment>
	</column>
	<column name="expires_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[issued + 5 min — FR-ACC-04]]> </comment>
	</column>
	<column name="attempts" not-null="true" default-value="0">
		<type name="smallint" length="0"/>
		<comment> <![CDATA[max 5 — FR-ACC-04]]> </comment>
	</column>
	<column name="superseded_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[a new OTP invalidates the previous]]> </comment>
	</column>
	<column name="consumed_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="issued_at" not-null="true" default-value="now()">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[v1.1.27: send instant; resend after 60 s, max 5 sends/hour/destination, expires_at = issued_at + 5 min — FR-ACC-04]]> </comment>
	</column>
	<constraint name="otp_challenge_pk" type="pk-constr" table="iam.otp_challenge">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_otp_purpose" type="ck-constr" table="iam.otp_challenge">
			<expression> <![CDATA[purpose IN ('PHONE_VERIFICATION','PASSWORD_RESET','PHONE_CHANGE')]]> </expression>
	</constraint>
	<constraint name="ck_otp_attempts" type="ck-constr" table="iam.otp_challenge">
			<expression> <![CDATA[attempts BETWEEN 0 AND 5]]> </expression>
	</constraint>
	<constraint name="ck_otp_validity" type="ck-constr" table="iam.otp_challenge">
			<expression> <![CDATA[expires_at = issued_at + interval '5 minutes']]> </expression>
	</constraint>
	<constraint name="ck_otp_lifecycle" type="ck-constr" table="iam.otp_challenge">
			<expression> <![CDATA[(consumed_at IS NULL OR superseded_at IS NULL) AND (consumed_at IS NULL OR (consumed_at >= issued_at AND consumed_at < expires_at)) AND (superseded_at IS NULL OR superseded_at >= issued_at)]]> </expression>
	</constraint>
</table>

