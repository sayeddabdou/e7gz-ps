	</constraint>
	<constraint name="ck_referral_not_self" type="ck-constr" table="loyalty.referral">
			<expression> <![CDATA[status='INVALID' OR referrer_user_id<>referred_user_id]]> </expression>
	</constraint>
	<constraint name="ck_referral_status" type="ck-constr" table="loyalty.referral">
			<expression> <![CDATA[status IN ('PENDING','REWARDED','INVALID')]]> </expression>
