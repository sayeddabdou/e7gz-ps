	</constraint>
	<constraint name="ck_notification_delivery_status" type="ck-constr" table="notification.notification_delivery">
			<expression> <![CDATA[status IN ('PENDING','SENT','FAILED','DEAD_LETTER')]]> </expression>
	</constraint>
	<constraint name="ck_notification_delivery_attempt" type="ck-constr" table="notification.notification_delivery">
			<expression> <![CDATA[attempt >= 0 AND (attempt = 0) = (last_attempt_at IS NULL)]]> </expression>
	</constraint>
	<constraint name="ck_notification_delivery_shape" type="ck-constr" table="notification.notification_delivery">
			<expression> <![CDATA[(status = 'SENT' AND provider_message_id IS NOT NULL AND last_attempt_at IS NOT NULL AND attempt > 0) OR (status IN ('FAILED','DEAD_LETTER') AND provider_message_id IS NULL AND error_code IS NOT NULL AND last_attempt_at IS NOT NULL AND attempt > 0) OR (status = 'PENDING' AND provider_message_id IS NULL)]]> </expression>
	</constraint>
	<constraint name="ck_notification_delivery_chronology" type="ck-constr" table="notification.notification_delivery">
			<expression> <![CDATA[last_attempt_at IS NULL OR last_attempt_at >= created_at]]> </expression>
	</constraint>
</table>

