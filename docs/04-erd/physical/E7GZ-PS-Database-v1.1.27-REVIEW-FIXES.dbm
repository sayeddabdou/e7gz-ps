		<columns names="event_sequence" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_trust_event_type" type="ck-constr" table="trust.trust_event">
			<expression> <![CDATA[event_type IN ('BOOKING_ATTENDED','BOOKING_ATTENDANCE_UNCONFIRMED','BOOKING_ATTENDED_INTERRUPTED','BOOKING_NO_SHOW','NO_SHOW_REVERSED','ATTENDANCE_CORRECTED','ADMIN_TRUST_ADJUSTMENT','VERIFIED_PLAYER_SUSPENDED','VERIFIED_PLAYER_REVOKED','VERIFIED_PLAYER_RESTORED','BOOKING_ACCOUNT_DISABLE_ATTENDANCE_PROTECTION')]]> </expression>
	</constraint>
	<constraint name="ck_trust_event_corrected_outcome" type="ck-constr" table="trust.trust_event">
			<expression> <![CDATA[(event_type = 'ATTENDANCE_CORRECTED' AND corrected_outcome IN ('ATTENDED','ATTENDED_INTERRUPTED','ATTENDANCE_UNCONFIRMED','ABSENT_NO_SHOW') AND original_outcome_event_id IS NOT NULL) OR (event_type = 'NO_SHOW_REVERSED' AND corrected_outcome IS NULL AND original_outcome_event_id IS NOT NULL AND superseded_correction_event_id IS NULL) OR (event_type NOT IN ('ATTENDANCE_CORRECTED','NO_SHOW_REVERSED') AND corrected_outcome IS NULL AND original_outcome_event_id IS NULL AND superseded_correction_event_id IS NULL)]]> </expression>
	</constraint>
	<constraint name="ck_trust_protection_booking_ref" type="ck-constr" table="trust.trust_event">
			<expression> <![CDATA[event_type <> 'BOOKING_ACCOUNT_DISABLE_ATTENDANCE_PROTECTION' OR booking_id IS NOT NULL]]> </expression>
	</constraint>
	<constraint name="ck_trust_correction_booking_ref" type="ck-constr" table="trust.trust_event">
			<expression> <![CDATA[event_type NOT IN ('ATTENDANCE_CORRECTED','NO_SHOW_REVERSED') OR booking_id IS NOT NULL]]> </expression>
	</constraint>
	<constraint name="ck_trust_booking_outcome_booking_ref" type="ck-constr" table="trust.trust_event">
			<expression> <![CDATA[event_type NOT IN ('BOOKING_ATTENDED','BOOKING_ATTENDANCE_UNCONFIRMED','BOOKING_ATTENDED_INTERRUPTED','BOOKING_NO_SHOW') OR booking_id IS NOT NULL]]> </expression>
	</constraint>
	<constraint name="ck_trust_event_time_order" type="ck-constr" table="trust.trust_event">
			<expression> <![CDATA[occurred_at >= effective_at]]> </expression>
	</constraint>
	<constraint name="ck_trust_event_payload_object" type="ck-constr" table="trust.trust_event">
			<expression> <![CDATA[jsonb_typeof(payload) = 'object']]> </expression>
	</constraint>
</table>

<table name="scheduled_job" layers="0" collapse-mode="2" max-obj-count="17" z-value="0">
	<schema name="technical"/>
	<role name="postgres"/>
	<comment> <![CDATA[Durable PostgreSQL scheduler. now < deadline permits; now >= deadline means expiry owns the state. Late workers revalidate and cannot change Product outcome. v1.1.25 generic lifecycle for every job type: PENDING -> LEASED | PAUSED | DONE | SUPERSEDED; PAUSED -> PENDING (explicit re-arm, the only path that may move due_at) | SUPERSEDED; LEASED -> DONE | FAILED | PENDING (release) | SUPERSEDED; FAILED -> PENDING (explicit re-arm) | SUPERSEDED; DONE and SUPERSEDED are terminal. type/subject/idempotency_key are immutable.]]> </comment>
	<position x="5400" y="11480"/>
	<column name="id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="type" not-null="true">
		<type name="text" length="0"/>
		<comment> <![CDATA[VENUE_RESPONSE_EXPIRY · LATE_CONFIRM_EXPIRY · BOOKING_START · ...]]> </comment>
	</column>
	<column name="subject_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="due_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[persisted — never computed at read time]]> </comment>
	</column>
	<column name="status" not-null="true">
		<type name="text" length="0"/>
		<comment> <![CDATA[PENDING · PAUSED · LEASED · DONE · SUPERSEDED · FAILED]]> </comment>
	</column>
	<column name="attempt" not-null="true" default-value="0">
		<type name="smallint" length="0"/>
	</column>
	<column name="leased_until">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="leased_by">
		<type name="text" length="0"/>
	</column>
	<column name="idempotency_key" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="last_error">
		<type name="text" length="0"/>
	</column>
	<column name="subject_type" not-null="true">
		<type name="text" length="0"/>
		<comment> <![CDATA[Aggregate type of subject_id (e.g. BOOKING, TOURNAMENT)]]> </comment>
	</column>
	<column name="created_at" not-null="true" default-value="clock_timestamp()">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="leased_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="completed_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<constraint name="scheduled_job_pk" type="pk-constr" table="technical.scheduled_job">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="uq_scheduled_job_idempotency_key" type="uq-constr" table="technical.scheduled_job">
		<columns names="idempotency_key" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_scheduled_job_status" type="ck-constr" table="technical.scheduled_job">
			<expression> <![CDATA[status IN ('PENDING','PAUSED','LEASED','DONE','SUPERSEDED','FAILED')]]> </expression>
	</constraint>
	<constraint name="ck_scheduled_job_lifecycle_shape" type="ck-constr" table="technical.scheduled_job">
			<expression> <![CDATA[attempt >= 0 AND length(btrim(subject_type)) > 0 AND ((status = 'LEASED') = (leased_at IS NOT NULL AND leased_until IS NOT NULL AND leased_by IS NOT NULL AND length(btrim(leased_by)) > 0)) AND (status = 'LEASED' OR (leased_at IS NULL AND leased_until IS NULL AND leased_by IS NULL)) AND ((status IN ('DONE','SUPERSEDED','FAILED')) = (completed_at IS NOT NULL)) AND (status <> 'FAILED' OR (last_error IS NOT NULL AND length(btrim(last_error)) > 0)) AND (leased_until IS NULL OR leased_until > leased_at) AND (completed_at IS NULL OR completed_at >= created_at)]]> </expression>
	</constraint>
	<constraint name="ck_scheduled_job_type_format" type="ck-constr" table="technical.scheduled_job">
			<expression> <![CDATA[type ~ '^[A-Z][A-Z0-9_]{0,63}$']]> </expression>
	</constraint>
</table>

