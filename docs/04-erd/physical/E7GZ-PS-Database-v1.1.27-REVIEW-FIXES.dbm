	</column>
	<column name="detail_code">
		<type name="varchar" length="80"/>
		<comment> <![CDATA[REQUIRED with LATE_CONFIRM_ELIGIBILITY_LOST_RESOURCE_STATE_CHANGED; forbidden for all other Booking Events.]]> </comment>
	</column>
	<column name="actor_type">
		<type name="text" length="0"/>
	</column>
	<column name="actor_id">
		<type name="uuid" length="0"/>
	</column>
	<column name="correlation_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<constraint name="booking_history_pk" type="pk-constr" table="booking.booking_history">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="uq_booking_history_seq" type="uq-constr" table="booking.booking_history">
		<columns names="booking_id,sequence" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_booking_history_entry_kind" type="ck-constr" table="booking.booking_history">
			<expression> <![CDATA[entry_kind IN ('STATUS_TRANSITION','BOOKING_EVENT')]]> </expression>
	</constraint>
	<constraint name="ck_booking_history_status_values" type="ck-constr" table="booking.booking_history">
			<expression> <![CDATA[(from_status IS NULL OR from_status IN ('PENDING','VENUE_RESPONSE_EXPIRED','AWAITING_CUSTOMER_CONFIRMATION','CONFIRMED','ACTIVE','COMPLETED','REJECTED','CANCELLED','NO_SHOW')) AND (to_status IS NULL OR to_status IN ('PENDING','VENUE_RESPONSE_EXPIRED','AWAITING_CUSTOMER_CONFIRMATION','CONFIRMED','ACTIVE','COMPLETED','REJECTED','CANCELLED','NO_SHOW'))]]> </expression>
	</constraint>
	<constraint name="ck_booking_history_terminal_reason_values" type="ck-constr" table="booking.booking_history">
			<expression> <![CDATA[(terminal_reason IS NULL OR terminal_reason IN ('CUSTOMER_CANCELLED','CUSTOMER_DECLINED_LATE_CONFIRM','CUSTOMER_RECONFIRM_TIMEOUT','VENUE_REJECTED','REJECTED_AFTER_EXPIRY','VENUE_CANCELLED_CONFIRMED_BOOKING','VENUE_CANCELLED_MANUAL_BOOKING','VENUE_DID_NOT_RESPOND_IN_TIME','VENUE_OPENING_HOURS_CHANGED','VENUE_CLOSURE','VENUE_EMERGENCY_CLOSURE','RESOURCE_EMERGENCY_OUTAGE','VENUE_RESPONSE_INTERRUPTED_BY_EMERGENCY','RESOURCE_RESPONSE_INTERRUPTED_BY_EMERGENCY','LATE_CONFIRM_INTERRUPTED_BY_EMERGENCY','RESOURCE_OWNER_REVIEW_REQUIRED','VENUE_ACCOUNT_DISABLED','SYSTEM_RESOURCE_STATE_INTEGRITY_ERROR','USER_BANNED','ADMIN_CANCELLED','ADMIN_CORRECTION','ADMIN_NO_SHOW_REVERSAL'))]]> </expression>
	</constraint>
	<constraint name="ck_booking_history_event_type_values" type="ck-constr" table="booking.booking_history">
			<expression> <![CDATA[(event_type IS NULL OR event_type IN ('CHECK_IN_RECORDED','CHECK_IN_REVERSED','LATE_PRESENT_RECORDED','LATE_PRESENT_REVERSED','NO_SHOW_RECORDED','NO_SHOW_REVERSED','ATTENDANCE_CORRECTED','LATE_CONFIRM_FAILED_RESOURCE_CONFLICT','LATE_CONFIRM_FAILED_CUSTOMER_CONFLICT','LATE_CONFIRM_FAILED_BOOKING_LIMIT','LATE_CONFIRM_ELIGIBILITY_LOST_RESOURCE_STATE_CHANGED','VENUE_RESPONSE_INTERRUPTED_BY_ACCOUNT_DISABLE'))]]> </expression>
	</constraint>
	<constraint name="ck_booking_history_entry_shape" type="ck-constr" table="booking.booking_history">
			<expression> <![CDATA[(entry_kind = 'STATUS_TRANSITION' AND to_status IS NOT NULL AND event_type IS NULL AND detail_code IS NULL) OR (entry_kind = 'BOOKING_EVENT' AND event_type IS NOT NULL AND from_status IS NULL AND to_status IS NULL AND terminal_reason IS NULL)]]> </expression>
	</constraint>
	<constraint name="ck_booking_history_transition_terminal_reason" type="ck-constr" table="booking.booking_history">
			<expression> <![CDATA[entry_kind = 'BOOKING_EVENT' OR ((to_status IN ('REJECTED','CANCELLED') AND terminal_reason IS NOT NULL) OR (to_status NOT IN ('REJECTED','CANCELLED') AND terminal_reason IS NULL))]]> </expression>
	</constraint>
	<constraint name="ck_booking_history_sequence_positive" type="ck-constr" table="booking.booking_history">
			<expression> <![CDATA[sequence > 0]]> </expression>
	</constraint>
	<constraint name="ck_booking_history_detail_code_scope" type="ck-constr" table="booking.booking_history">
			<expression> <![CDATA[(event_type = 'LATE_CONFIRM_ELIGIBILITY_LOST_RESOURCE_STATE_CHANGED' AND detail_code IS NOT NULL AND detail_code IN ('RESOURCE_DISABLED','RESOURCE_ARCHIVED','RESOURCE_CONSOLE_CHANGED','RESOURCE_OWNER_REVIEW_REQUIRED')) OR (event_type IS DISTINCT FROM 'LATE_CONFIRM_ELIGIBILITY_LOST_RESOURCE_STATE_CHANGED' AND detail_code IS NULL)]]> </expression>
	</constraint>
	<constraint name="ck_booking_history_actor_type_values" type="ck-constr" table="booking.booking_history">
			<expression> <![CDATA[actor_type IS NULL OR actor_type IN ('CUSTOMER','VENUE','ADMIN','SYSTEM')]]> </expression>
	</constraint>
</table>

<table name="late_confirmation" layers="0" collapse-mode="2" max-obj-count="13" z-value="0">
	<schema name="booking"/>
	<role name="postgres"/>
	<comment> <![CDATA[Per-booking Late Confirmation state. The same Booking ID is retained. One open attempt per Booking is enforced physically by closed_at IS NULL; Customer response is a separate fact, so operational/system cancellation can close an attempt without inventing a Customer response. Each row owns one canonical LATE_CONFIRM_HOLD reservation for the same Booking/Resource/interval. Emergency pause/resume may move the persisted deadline but never beyond the original Booking startAt.

Source/critical constraints:
- uq_lc_attempt + uq_lc_hold_reservation
- ux_lc_open (one closed_at IS NULL attempt per booking)
- ck_lc_response_shape + ck_lc_open_closed_shape + positive attempt/window checks
- exact initial five-minute expiry guard
- deferred cross-surface Late Confirmation integrity against Booking + Inventory]]> </comment>
	<position x="4360" y="4880"/>
	<column name="id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="booking_id" not-null="true">
		<type name="uuid" length="0"/>
		<comment> <![CDATA[SAME Booking ID — FR-LCF-08]]> </comment>
	</column>
	<column name="attempt_no" not-null="true">
		<type name="smallint" length="0"/>
	</column>
	<column name="initiated_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="expires_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[MIN(now + 5 min, booking.start_at)]]> </comment>
	</column>
	<column name="warning_sent_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[only when the window > 60 s]]> </comment>
	</column>
	<column name="hold_reservation_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="customer_response">
		<type name="text" length="0"/>
		<comment> <![CDATA[ACCEPTED · DECLINED · TIMED_OUT]]> </comment>
	</column>
	<column name="responded_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="closed_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[Implementation-only lifecycle marker. NULL means the Late Confirmation attempt is still open; non-NULL closes it for Customer response or any Product-defined operational/system cancellation. Not a Product status or reason.]]> </comment>
	</column>
	<constraint name="late_confirmation_pk" type="pk-constr" table="booking.late_confirmation">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="uq_late_confirm_attempt" type="uq-constr" table="booking.late_confirmation">
		<columns names="booking_id,attempt_no" ref-type="src-columns"/>
	</constraint>
	<constraint name="uq_late_confirm_hold_reservation" type="uq-constr" table="booking.late_confirmation">
		<columns names="hold_reservation_id" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_late_confirmation_customer_response" type="ck-constr" table="booking.late_confirmation">
			<expression> <![CDATA[(customer_response IS NULL OR customer_response IN ('ACCEPTED','DECLINED','TIMED_OUT'))]]> </expression>
	</constraint>
	<constraint name="ck_late_confirmation_attempt_positive" type="ck-constr" table="booking.late_confirmation">
			<expression> <![CDATA[attempt_no > 0]]> </expression>
	</constraint>
	<constraint name="ck_late_confirmation_window_positive" type="ck-constr" table="booking.late_confirmation">
			<expression> <![CDATA[expires_at > initiated_at]]> </expression>
	</constraint>
	<constraint name="ck_late_confirmation_response_shape" type="ck-constr" table="booking.late_confirmation">
			<expression> <![CDATA[(customer_response IS NULL AND responded_at IS NULL) OR (customer_response IN ('ACCEPTED','DECLINED') AND responded_at IS NOT NULL AND responded_at >= initiated_at AND responded_at < expires_at) OR (customer_response = 'TIMED_OUT' AND responded_at IS NOT NULL AND responded_at >= expires_at)]]> </expression>
	</constraint>
	<constraint name="ck_late_confirmation_open_closed_shape" type="ck-constr" table="booking.late_confirmation">
			<expression> <![CDATA[(closed_at IS NULL AND customer_response IS NULL AND responded_at IS NULL) OR (closed_at IS NOT NULL AND closed_at >= initiated_at AND ((customer_response IS NULL AND responded_at IS NULL) OR (customer_response IS NOT NULL AND responded_at IS NOT NULL AND closed_at >= responded_at)))]]> </expression>
	</constraint>
	<constraint name="ck_late_confirmation_warning_time" type="ck-constr" table="booking.late_confirmation">
			<expression> <![CDATA[warning_sent_at IS NULL OR (warning_sent_at >= initiated_at AND warning_sent_at < expires_at)]]> </expression>
	</constraint>
</table>

<table name="attendance_record" layers="0" collapse-mode="2" max-obj-count="14" z-value="0">
	<schema name="attendance"/>
	<role name="postgres"/>
	<comment> <![CDATA[Attendance evidence/current outcome row. result is NULL until the effective Attendance Result is resolved, then becomes historical Product data subject only to an explicitly audited Admin correction. Original evidence timestamps are one-way; approved reversal timestamps retain the original evidence instead of deleting it. Booking History + Audit Event remain the actor/reason authority for every attendance action/reversal/correction.

Hardening:
- active Check-in / Late Present / No-show evidence is mutually exclusive
- reversal timestamps require the original evidence and cannot predate it
- cross-table guards enforce Product time windows, same-Venue actor, No-show atomic final state and audited corrections]]> </comment>
	<position x="5400" y="4880"/>
	<column name="id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="booking_id" not-null="true">
		<type name="uuid" length="0"/>
		<comment> <![CDATA[UNIQUE — one Attendance state/evidence row per Booking]]> </comment>
	</column>
	<column name="result">
		<type name="varchar" length="80"/>
		<comment> <![CDATA[NULL until resolved · ATTENDED · ATTENDANCE_UNCONFIRMED · ATTENDED_INTERRUPTED · ABSENT_NO_SHOW · NOT_APPLICABLE]]> </comment>
	</column>
	<column name="check_in_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[[start, start+15m); immutable once recorded]]> </comment>
	</column>
	<column name="check_in_reversed_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[Platform Admin only; one-way reversal marker; mandatory audited reason]]> </comment>
	</column>
	<column name="late_present_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[[start+15m, end); immutable once recorded]]> </comment>
	</column>
	<column name="late_present_reversed_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[Platform Admin only; one-way reversal marker; mandatory audited reason]]> </comment>
	</column>
	<column name="no_show_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[[start+15m, end); terminal No-show action]]> </comment>
	</column>
	<column name="no_show_reversed_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[Platform Admin only; one-way reversal marker; mandatory audited reason]]> </comment>
	</column>
	<column name="recorded_by_venue_account_id">
		<type name="uuid" length="0"/>
		<comment> <![CDATA[Venue account for the most recently written original attendance evidence; full per-action actor history is authoritative in Booking History/Audit]]> </comment>
	</column>
	<column name="resolved_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[NULL while unresolved; moves forward only when an audited Admin correction changes result]]> </comment>
	</column>
	<column name="protection_applied" not-null="true" default-value="false">
		<type name="boolean" length="0"/>
		<comment> <![CDATA[Historical flag: an effective BOOKING_ACCOUNT_DISABLE_ATTENDANCE_PROTECTION Trust event was emitted; never silently cleared]]> </comment>
	</column>
	<constraint name="attendance_record_pk" type="pk-constr" table="attendance.attendance_record">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="uq_attendance_booking" type="uq-constr" table="attendance.attendance_record">
		<columns names="booking_id" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_attendance_result_values" type="ck-constr" table="attendance.attendance_record">
			<expression> <![CDATA[result IS NULL OR result IN ('ATTENDED','ATTENDANCE_UNCONFIRMED','ATTENDED_INTERRUPTED','ABSENT_NO_SHOW','NOT_APPLICABLE')]]> </expression>
	</constraint>
	<constraint name="ck_attendance_resolution_shape" type="ck-constr" table="attendance.attendance_record">
			<expression> <![CDATA[(result IS NULL AND resolved_at IS NULL) OR (result IS NOT NULL AND resolved_at IS NOT NULL)]]> </expression>
	</constraint>
	<constraint name="ck_attendance_reversal_chronology" type="ck-constr" table="attendance.attendance_record">
			<expression> <![CDATA[(check_in_reversed_at IS NULL OR (check_in_at IS NOT NULL AND check_in_reversed_at >= check_in_at)) AND (late_present_reversed_at IS NULL OR (late_present_at IS NOT NULL AND late_present_reversed_at >= late_present_at)) AND (no_show_reversed_at IS NULL OR (no_show_at IS NOT NULL AND no_show_reversed_at >= no_show_at))]]> </expression>
	</constraint>
	<constraint name="ck_attendance_active_evidence_exclusive" type="ck-constr" table="attendance.attendance_record">
			<expression> <![CDATA[(CASE WHEN check_in_at IS NOT NULL AND check_in_reversed_at IS NULL THEN 1 ELSE 0 END) + (CASE WHEN late_present_at IS NOT NULL AND late_present_reversed_at IS NULL THEN 1 ELSE 0 END) + (CASE WHEN no_show_at IS NOT NULL AND no_show_reversed_at IS NULL THEN 1 ELSE 0 END) <= 1]]> </expression>
	</constraint>
	<constraint name="ck_attendance_venue_actor_presence" type="ck-constr" table="attendance.attendance_record">
			<expression> <![CDATA[(check_in_at IS NULL AND late_present_at IS NULL AND no_show_at IS NULL) OR recorded_by_venue_account_id IS NOT NULL]]> </expression>
	</constraint>
</table>

