	</column>
	<column name="period" not-null="true">
		<type name="tstzrange" length="0"/>
	</column>
	<column name="reason" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="created_from_emergency_id">
		<type name="uuid" length="0"/>
		<comment> <![CDATA[counts toward the same rolling total]]> </comment>
	</column>
	<column name="owner_password_used" not-null="true">
		<type name="boolean" length="0"/>
		<comment> <![CDATA[required over 24h-in-48h — FR-OPS-03]]> </comment>
	</column>
	<constraint name="maintenance_window_pk" type="pk-constr" table="operations.maintenance_window">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_maintenance_period_canonical" type="ck-constr" table="operations.maintenance_window">
			<expression> <![CDATA[NOT isempty(period) AND lower(period) IS NOT NULL AND upper(period) IS NOT NULL AND lower(period) < upper(period) AND lower_inc(period) AND NOT upper_inc(period)]]> </expression>
	</constraint>
	<constraint name="ck_maintenance_reason_nonempty" type="ck-constr" table="operations.maintenance_window">
			<expression> <![CDATA[length(btrim(reason)) > 0]]> </expression>
	</constraint>
</table>

