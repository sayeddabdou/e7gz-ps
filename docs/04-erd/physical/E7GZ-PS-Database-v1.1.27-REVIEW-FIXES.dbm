	</constraint>
	<constraint name="ck_tournament_duration" type="ck-constr" table="tournament.tournament">
			<expression> <![CDATA[nominal_minutes >= 60 AND MOD(nominal_minutes,30)=0]]> </expression>
	</constraint>
	<constraint name="ck_tournament_terminal_reason" type="ck-constr" table="tournament.tournament">
			<expression> <![CDATA[(status IN ('CANCELLED','REJECTED') AND terminal_reason IS NOT NULL) OR (status NOT IN ('CANCELLED','REJECTED') AND terminal_reason IS NULL)]]> </expression>
	</constraint>
	<constraint name="ck_tournament_host_type" type="ck-constr" table="tournament.tournament">
			<expression> <![CDATA[host_type IN ('PLAYER','VENUE')]]> </expression>
	</constraint>
	<constraint name="ck_tournament_activity" type="ck-constr" table="tournament.tournament">
			<expression> <![CDATA[activity IN ('PLAYSTATION','BILLIARDS','PING_PONG')]]> </expression>
	</constraint>
	<constraint name="ck_tournament_play_mode" type="ck-constr" table="tournament.tournament">
			<expression> <![CDATA[(activity = 'PLAYSTATION' AND play_mode IN ('SINGLE','MULTIPLAYER')) OR (activity IN ('BILLIARDS','PING_PONG') AND play_mode IS NULL)]]> </expression>
	</constraint>
	<constraint name="ck_tournament_status_values" type="ck-constr" table="tournament.tournament">
			<expression> <![CDATA[status IN ('PENDING_VENUE_APPROVAL','WAITING_FOR_PLAYERS','CONFIRMED','ACTIVE','COMPLETED','REJECTED','CANCELLED')]]> </expression>
	</constraint>
	<constraint name="ck_tournament_visibility" type="ck-constr" table="tournament.tournament">
			<expression> <![CDATA[visibility IN ('PUBLIC','PRIVATE')]]> </expression>
	</constraint>
	<constraint name="ck_tournament_terminal_reason_values" type="ck-constr" table="tournament.tournament">
			<expression> <![CDATA[(terminal_reason IS NULL OR terminal_reason IN ('CREATOR_CANCELLED','VENUE_CANCELLED','ADMIN_CANCELLED','VENUE_REJECTED_TOURNAMENT','VENUE_DID_NOT_APPROVE_TOURNAMENT_IN_TIME','MINIMUM_PARTICIPANTS_NOT_REACHED','CREATOR_VERIFIED_STATUS_REVOKED','TOURNAMENT_OPERATIONAL_TERMINATION','EMERGENCY_CLOSURE','RESOURCE_EMERGENCY_OUTAGE','RESOURCE_OWNER_REVIEW_REQUIRED','VENUE_ACCOUNT_DISABLED'))]]> </expression>
	</constraint>
	<constraint name="ck_tournament_host_creator_shape" type="ck-constr" table="tournament.tournament">
			<expression> <![CDATA[(host_type = 'PLAYER' AND creator_user_id IS NOT NULL AND creator_participates IS NOT NULL) OR (host_type = 'VENUE' AND creator_user_id IS NULL AND creator_participates IS NULL)]]> </expression>
	</constraint>
	<constraint name="ck_tournament_time_arithmetic" type="ck-constr" table="tournament.tournament">
			<expression> <![CDATA[end_at = start_at + make_interval(mins => nominal_minutes) AND checkpoint_at = start_at - interval '1 hour' AND created_at <= start_at - interval '2 hours']]> </expression>
	</constraint>
	<constraint name="ck_tournament_approval_deadline" type="ck-constr" table="tournament.tournament">
			<expression> <![CDATA[(host_type = 'PLAYER' AND approval_expires_at IS NOT NULL AND approval_expires_at = LEAST(created_at + interval '10 minutes', checkpoint_at)) OR (host_type = 'VENUE' AND approval_expires_at IS NULL AND status <> 'PENDING_VENUE_APPROVAL')]]> </expression>
	</constraint>
	<constraint name="ck_tournament_money_nonnegative" type="ck-constr" table="tournament.tournament">
			<expression> <![CDATA[venue_cost_total >= 0 AND creation_fee_snapshot >= 0 AND entry_fee >= 0 AND prize >= 0]]> </expression>
	</constraint>
	<constraint name="ck_tournament_private_invite" type="ck-constr" table="tournament.tournament">
			<expression> <![CDATA[visibility <> 'PRIVATE' OR NULLIF(BTRIM(invite_code),'') IS NOT NULL]]> </expression>
	</constraint>
	<constraint name="ck_tournament_version_nonnegative" type="ck-constr" table="tournament.tournament">
			<expression> <![CDATA[version >= 0]]> </expression>
	</constraint>
	<constraint name="ck_tournament_rejected_reason" type="ck-constr" table="tournament.tournament">
			<expression> <![CDATA[(status = 'REJECTED') = (terminal_reason IS NOT DISTINCT FROM 'VENUE_REJECTED_TOURNAMENT')]]> </expression>
	</constraint>
</table>

<table name="tournament_resource" layers="0" collapse-mode="2" max-obj-count="10" z-value="0">
	<schema name="tournament"/>
	<role name="postgres"/>
	<comment> <![CDATA[Exactly 1 to 4 historical assignment rows. Snapshots are immutable. Player-hosted Venue Accept replaces the immutable Approval Hold with a new standard Tournament Hold and updates reservation_id once. ACTIVE Resource loss is a one-way removed_at/removal_cause write and never changes stored Tournament cost.]]> </comment>
