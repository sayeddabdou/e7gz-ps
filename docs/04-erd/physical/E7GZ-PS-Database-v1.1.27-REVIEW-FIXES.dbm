	<column name="referral_id">
		<type name="uuid" length="0"/>
	</column>
	<column name="granted_value_snapshot" not-null="true" default-value="0">
		<type name="integer" length="0"/>
		<comment> <![CDATA[historical snapshot. the configured value AT the moment]]> </comment>
	</column>
	<column name="compensates_transaction_id">
		<type name="uuid" length="0"/>
	</column>
	<column name="unrecovered_reversal_amount" not-null="true" default-value="0">
		<type name="integer" length="0"/>
		<comment> <![CDATA[never debt, never auto-repaid]]> </comment>
	</column>
	<column name="admin_id">
		<type name="uuid" length="0"/>
	</column>
	<column name="reason">
		<type name="text" length="0"/>
	</column>
	<column name="occurred_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="ledger_sequence" not-null="true">
		<type name="bigint" length="0"/>
	</column>
	<column name="operation_key" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="requested_amount" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<column name="balance_before" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<column name="balance_after" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<column name="source_trust_event_id">
		<type name="uuid" length="0"/>
	</column>
	<column name="configuration_as_of">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="configuration_version_id">
		<type name="uuid" length="0"/>
	</column>
	<column name="correlation_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="audit_event_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="outbox_event_id" not-null="true">
		<type name="bigint" length="0"/>
	</column>
	<constraint name="points_transaction_pk" type="pk-constr" table="loyalty.points_transaction">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_points_transaction_cause" type="ck-constr" table="loyalty.points_transaction">
			<expression> <![CDATA[cause IN ('ATTENDED_COMPLETION','REFERRAL_SIGNUP','COMPENSATION','ADMIN')]]> </expression>
	</constraint>
	<constraint name="ck_points_tx_amounts" type="ck-constr" table="loyalty.points_transaction">
			<expression> <![CDATA[balance_before>=0 AND balance_after>=0 AND balance_after::bigint=balance_before::bigint+amount::bigint AND granted_value_snapshot>=0 AND unrecovered_reversal_amount>=0 AND ((requested_amount>=0 AND amount=requested_amount AND unrecovered_reversal_amount=0) OR (requested_amount<0 AND amount=GREATEST(requested_amount,-balance_before) AND unrecovered_reversal_amount::bigint=amount::bigint-requested_amount::bigint))]]> </expression>
	</constraint>
	<constraint name="ck_points_tx_origin" type="ck-constr" table="loyalty.points_transaction">
			<expression> <![CDATA[(cause='ATTENDED_COMPLETION' AND booking_id IS NOT NULL AND referral_id IS NULL AND source_trust_event_id IS NOT NULL AND compensates_transaction_id IS NULL AND amount>=0) OR (cause='REFERRAL_SIGNUP' AND referral_id IS NOT NULL AND booking_id IS NULL AND source_trust_event_id IS NULL AND compensates_transaction_id IS NULL AND amount>=0) OR (cause='COMPENSATION' AND compensates_transaction_id IS NOT NULL AND ((booking_id IS NOT NULL AND referral_id IS NULL AND source_trust_event_id IS NOT NULL) OR (booking_id IS NULL AND referral_id IS NOT NULL AND source_trust_event_id IS NULL))) OR (cause='ADMIN' AND booking_id IS NULL AND referral_id IS NULL AND source_trust_event_id IS NULL AND compensates_transaction_id IS NULL AND admin_id IS NOT NULL AND NULLIF(btrim(reason),'') IS NOT NULL)]]> </expression>
	</constraint>
	<constraint name="ck_points_tx_config" type="ck-constr" table="loyalty.points_transaction">
			<expression> <![CDATA[(cause='ADMIN' AND configuration_version_id IS NULL AND configuration_as_of IS NULL) OR (cause<>'ADMIN' AND configuration_version_id IS NOT NULL AND configuration_as_of IS NOT NULL)]]> </expression>
	</constraint>
	<constraint name="uq_points_tx_operation" type="uq-constr" table="loyalty.points_transaction">
		<columns names="operation_key" ref-type="src-columns"/>
	</constraint>
	<constraint name="uq_points_tx_sequence" type="uq-constr" table="loyalty.points_transaction">
		<columns names="ledger_sequence" ref-type="src-columns"/>
	</constraint>
</table>

