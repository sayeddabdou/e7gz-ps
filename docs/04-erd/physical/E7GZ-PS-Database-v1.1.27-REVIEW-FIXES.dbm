<dbmodel pgmodeler-ver="1.2.2" use-changelog="false" max-obj-count="260"
	 gen-disabled-objs-code="false" show-sys-schemas-rects="true"
	 last-position="0,0" last-zoom="0.25" scene-rect="0,-0.5,10136.3,12133.2"
	 default-owner="postgres"
	 layers="Default layer"
