<table name="maintenance_window" layers="0" collapse-mode="2" max-obj-count="7" z-value="0">
	<schema name="operations"/>
	<role name="postgres"/>
	<comment> <![CDATA[A1 CLOSED: same-Resource Maintenance windows MAY overlap or be back-to-back. Overlapping/back-to-back time is unioned for the rolling-48h threshold and is never double-counted. Maintenance may not overlap existing Booking/Tournament commitments or a pre-existing Closure; it never silently cancels commitments. v1.1.6 database guards serialize on the Resource row and enforce the >24h-in-any-48h Owner-Password threshold for non-emergency Maintenance and edits.]]> </comment>
	<position x="200" y="4880"/>
	<column name="id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="resource_id" not-null="true">
