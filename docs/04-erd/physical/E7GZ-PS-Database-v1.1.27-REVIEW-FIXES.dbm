			<expression> <![CDATA[(terminal_reason IS NULL OR terminal_reason IN ('CUSTOMER_CANCELLED','CUSTOMER_DECLINED_LATE_CONFIRM','CUSTOMER_RECONFIRM_TIMEOUT','VENUE_REJECTED','REJECTED_AFTER_EXPIRY','VENUE_CANCELLED_CONFIRMED_BOOKING','VENUE_CANCELLED_MANUAL_BOOKING','VENUE_DID_NOT_RESPOND_IN_TIME','VENUE_OPENING_HOURS_CHANGED','VENUE_CLOSURE','VENUE_EMERGENCY_CLOSURE','RESOURCE_EMERGENCY_OUTAGE','VENUE_RESPONSE_INTERRUPTED_BY_EMERGENCY','RESOURCE_RESPONSE_INTERRUPTED_BY_EMERGENCY','LATE_CONFIRM_INTERRUPTED_BY_EMERGENCY','RESOURCE_OWNER_REVIEW_REQUIRED','VENUE_ACCOUNT_DISABLED','SYSTEM_RESOURCE_STATE_INTEGRITY_ERROR','USER_BANNED','ADMIN_CANCELLED','ADMIN_CORRECTION','ADMIN_NO_SHOW_REVERSAL'))]]> </expression>
	</constraint>
