			<expression> <![CDATA[code ~ '^[A-Z][A-Z0-9_]{1,99}$' AND reference_type IN ('BOOKING','TOURNAMENT','NONE') AND cardinality(recipient_types) > 0 AND recipient_types <@ ARRAY['CUSTOMER','VENUE','ADMIN']::text[] AND cardinality(required_channels) > 0 AND required_channels <@ allowed_channels AND allowed_channels <@ ARRAY['IN_APP','PUSH','EMAIL','SMS']::text[] AND (('SMS' = ANY(allowed_channels)) = otp_only) AND (NOT otp_only OR allowed_channels = ARRAY['SMS']::text[]) AND length(btrim(source_reference)) > 0]]> </expression>
	</constraint>
