	</constraint>
	<constraint name="ck_review_moderation_transition" type="ck-constr" table="review.review_moderation_event">
			<expression> <![CDATA[(action = 'APPROVE' AND previous_status = 'PENDING_MODERATION' AND new_status = 'ACTIVE') OR (action = 'HIDE' AND previous_status = 'ACTIVE' AND new_status = 'HIDDEN') OR (action = 'RESTORE' AND previous_status = 'HIDDEN' AND new_status = 'ACTIVE') OR (action = 'REMOVE' AND previous_status IN ('ACTIVE','HIDDEN','PENDING_MODERATION') AND new_status = 'REMOVED')]]> </expression>
	</constraint>
