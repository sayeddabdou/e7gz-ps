	<constraint name="ck_referral_shape" type="ck-constr" table="loyalty.referral">
			<expression> <![CDATA[NULLIF(btrim(code),'') IS NOT NULL AND jsonb_typeof(fraud_signals)='object' AND (referrer_user_id IS NOT NULL OR (status='INVALID' AND invalidation_kind='INVALID_CODE')) AND ((status='PENDING' AND rewarded_at IS NULL AND invalidated_at IS NULL AND reward_value_applied IS NULL AND verified_at_snapshot IS NULL) OR (status='REWARDED' AND rewarded_at IS NOT NULL AND verified_at_snapshot IS NOT NULL AND configuration_version_id IS NOT NULL AND reward_value_applied IS NOT NULL AND reward_value_applied>=0 AND invalidated_at IS NULL) OR (status='INVALID' AND invalidated_at IS NOT NULL AND invalidation_kind IS NOT NULL AND NULLIF(btrim(invalidation_reason),'') IS NOT NULL AND invalidation_kind IN ('INVALID_CODE','SELF_REFERRAL','ADMIN_FRAUD') AND (rewarded_at IS NULL OR (verified_at_snapshot IS NOT NULL AND reward_value_applied IS NOT NULL AND reward_value_applied>=0 AND configuration_version_id IS NOT NULL))))]]> </expression>
	</constraint>
</table>

