<table name="emergency" layers="0" collapse-mode="2" max-obj-count="14" z-value="0">
	<schema name="operations"/>
	<role name="postgres"/>
	<comment> <![CDATA[Layer 2 operational state. An unresolved Emergency is NEVER an infinite Resource reservation. Runtime guards make declaration start at database NOW, keep the declared cascade range canonical [declared_at, expected_end_at), require the expected end inside the declaration Operating Session, serialize Venue/Resource races, enforce the canonical status transition graph, and couple ACTIVE/AWAITING versus ENDED/CONVERTED atomically to the matching Operational Selling Block. ended_at is the physical resolution timestamp for ENDED or CONVERTED.

Source/critical constraints include scope, status, scope shape, conversion target/shape, time order, canonical declared period and lifecycle shape.]]> </comment>
	<position x="1760" y="4880"/>
	<column name="id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="scope" not-null="true">
		<type name="varchar" length="80"/>
		<comment> <![CDATA[VENUE · RESOURCE]]> </comment>
	</column>
	<column name="venue_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="resource_id">
		<type name="uuid" length="0"/>
	</column>
	<column name="status" not-null="true">
		<type name="varchar" length="80"/>
		<comment> <![CDATA[ACTIVE · AWAITING_CONFIRMATION · ENDED · CONVERTED]]> </comment>
	</column>
	<column name="declared_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[NOW only, never scheduled — FR-OPS-06]]> </comment>
	</column>
	<column name="expected_end_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[mandatory, within the current session]]> </comment>
	</column>
	<column name="declared_period" not-null="true">
		<type name="tstzrange" length="0"/>
		<comment> <![CDATA[the cascade window]]> </comment>
	</column>
	<column name="reason" not-null="true">
		<type name="text" length="0"/>
		<comment> <![CDATA[mandatory]]> </comment>
	</column>
	<column name="converted_to">
		<type name="text" length="0"/>
		<comment> <![CDATA[CLOSURE · OPENING_HOURS_CHANGE · MAINTENANCE · DISABLED · ARCHIVED]]> </comment>
	</column>
	<column name="ended_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<constraint name="emergency_pk" type="pk-constr" table="operations.emergency">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_emergency_scope" type="ck-constr" table="operations.emergency">
			<expression> <![CDATA[scope IN ('VENUE','RESOURCE')]]> </expression>
	</constraint>
	<constraint name="ck_emergency_status" type="ck-constr" table="operations.emergency">
			<expression> <![CDATA[status IN ('ACTIVE','AWAITING_CONFIRMATION','ENDED','CONVERTED')]]> </expression>
	</constraint>
	<constraint name="ck_emergency_scope_shape" type="ck-constr" table="operations.emergency">
			<expression> <![CDATA[(scope = 'VENUE' AND resource_id IS NULL) OR (scope = 'RESOURCE' AND resource_id IS NOT NULL)]]> </expression>
	</constraint>
	<constraint name="ck_emergency_conversion_target" type="ck-constr" table="operations.emergency">
			<expression> <![CDATA[converted_to IS NULL OR (scope = 'VENUE' AND converted_to IN ('CLOSURE','OPENING_HOURS_CHANGE')) OR (scope = 'RESOURCE' AND converted_to IN ('MAINTENANCE','DISABLED','ARCHIVED'))]]> </expression>
	</constraint>
	<constraint name="ck_emergency_conversion_shape" type="ck-constr" table="operations.emergency">
			<expression> <![CDATA[(status = 'CONVERTED' AND converted_to IS NOT NULL) OR (status <> 'CONVERTED' AND converted_to IS NULL)]]> </expression>
	</constraint>
	<constraint name="ck_emergency_time_order" type="ck-constr" table="operations.emergency">
			<expression> <![CDATA[expected_end_at > declared_at]]> </expression>
	</constraint>
	<constraint name="ck_emergency_period_canonical" type="ck-constr" table="operations.emergency">
			<expression> <![CDATA[declared_period = tstzrange(declared_at, expected_end_at, '[)')]]> </expression>
	</constraint>
	<constraint name="ck_emergency_reason_nonempty" type="ck-constr" table="operations.emergency">
			<expression> <![CDATA[length(btrim(reason)) > 0]]> </expression>
	</constraint>
	<constraint name="ck_emergency_terminal_shape" type="ck-constr" table="operations.emergency">
			<expression> <![CDATA[(status IN ('ACTIVE','AWAITING_CONFIRMATION') AND ended_at IS NULL) OR (status IN ('ENDED','CONVERTED') AND ended_at IS NOT NULL AND ended_at >= declared_at)]]> </expression>
	</constraint>
</table>

<table name="owner_review" layers="0" collapse-mode="2" max-obj-count="9" z-value="0">
	<schema name="operations"/>
	<role name="postgres"/>
	<comment> <![CDATA[Physical OWNER_REVIEW_REQUIRED lifecycle. One open review per Resource. Entry is a System consequence and carries owner_password_used=false; resolution is a one-time close mutation, requires Owner Password, and must reconcile to the selected final Resource action in the same transaction.]]> </comment>
	<position x="980" y="5400"/>
	<column name="id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="resource_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="entered_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="entry_cause" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="resolved_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="resolution">
		<type name="text" length="0"/>
		<comment> <![CDATA[RETURN_TO_SERVICE · EXTEND_MAINTENANCE · DISABLE · ARCHIVE]]> </comment>
	</column>
	<column name="owner_password_used" not-null="true" default-value="false">
		<type name="boolean" length="0"/>
	</column>
	<column name="correlation_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<constraint name="owner_review_pk" type="pk-constr" table="operations.owner_review">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_owner_review_resolution" type="ck-constr" table="operations.owner_review">
			<expression> <![CDATA[(resolution IS NULL OR resolution IN ('RETURN_TO_SERVICE','EXTEND_MAINTENANCE','DISABLE','ARCHIVE'))]]> </expression>
	</constraint>
	<constraint name="ck_owner_review_entry_cause_nonempty" type="ck-constr" table="operations.owner_review">
			<expression> <![CDATA[length(btrim(entry_cause)) > 0]]> </expression>
	</constraint>
	<constraint name="ck_owner_review_lifecycle" type="ck-constr" table="operations.owner_review">
			<expression> <![CDATA[(resolved_at IS NULL AND resolution IS NULL AND owner_password_used = false) OR (resolved_at IS NOT NULL AND resolution IS NOT NULL AND owner_password_used = true AND resolved_at >= entered_at)]]> </expression>
	</constraint>
</table>

<table name="operational_interruption_record" layers="0" collapse-mode="2" max-obj-count="10" z-value="0">
	<schema name="operations"/>
	<role name="postgres"/>
	<comment> <![CDATA[APPEND-ONLY operational interruption snapshot. Polymorphic subject identity is validated at write time. attendance_evidence may retain the source-backed Attendance Result / valid Check-in / Late Present / initiating-event evidence; refund_amount stores the historical Booking Fee refund amount required by Product §53.2.]]> </comment>
	<position x="1760" y="5400"/>
	<column name="id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="subject_type" not-null="true">
		<type name="text" length="0"/>
		<comment> <![CDATA[BOOKING · MANUAL_BOOKING · TOURNAMENT]]> </comment>
	</column>
	<column name="subject_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="cause" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="occurred_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="attendance_evidence">
		<type name="jsonb" length="0"/>
	</column>
	<column name="refund_applied" not-null="true">
		<type name="boolean" length="0"/>
	</column>
	<column name="refund_amount" not-null="true" default-value="0">
		<type name="numeric" length="12" precision="2"/>
		<comment> <![CDATA[Booking Fee refund amount snapshot; 0 at Launch is still a valid applied full-refund classification.]]> </comment>
	</column>
	<column name="correlation_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<constraint name="operational_interruption_record_pk" type="pk-constr" table="operations.operational_interruption_record">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_operational_interruption_subject_type" type="ck-constr" table="operations.operational_interruption_record">
			<expression> <![CDATA[subject_type IN ('BOOKING','MANUAL_BOOKING','TOURNAMENT')]]> </expression>
	</constraint>
	<constraint name="ck_operational_interruption_cause_nonempty" type="ck-constr" table="operations.operational_interruption_record">
			<expression> <![CDATA[length(btrim(cause)) > 0]]> </expression>
	</constraint>
	<constraint name="ck_operational_interruption_refund_amount" type="ck-constr" table="operations.operational_interruption_record">
			<expression> <![CDATA[refund_amount >= 0 AND (refund_applied OR refund_amount = 0)]]> </expression>
	</constraint>
	<constraint name="ck_operational_interruption_evidence_object" type="ck-constr" table="operations.operational_interruption_record">
			<expression> <![CDATA[attendance_evidence IS NULL OR jsonb_typeof(attendance_evidence) = 'object']]> </expression>
	</constraint>
</table>

<table name="booking" layers="0" collapse-mode="2" max-obj-count="44" z-value="0">
	<schema name="booking"/>
	<role name="postgres"/>
	<comment> <![CDATA[Online + Manual share one aggregate. Source never decides inventory blocking; status does. Canonical terminal semantics: REJECTED/CANCELLED carry one closed Booking Reason Code; COMPLETED and NO_SHOW are terminal with NULL Booking Reason Code. NO_SHOW_RECORDED is a Booking Event and ABSENT_NO_SHOW is an Attendance Result; neither is a Booking Reason Code.

Source/critical constraints:
- ck_booking_terminal_reason + ck_booking_terminal_at
- ck_booking_duration + ck_booking_time_math
- ck_booking_manual_states
- ck_booking_snapshot_dimensions
- ck_booking_money_nonnegative + price/total arithmetic checks
- ck_booking_fee_treatment_scope + ck_booking_manual_fee_zero + reason-map trigger
- ck_booking_pause_counters + ck_booking_pause_state_scope
- ex_customer_no_overlap EXCLUDE (customer_id =, commitment_period &&)
- tr_booking_snapshot_integrity + tr_booking_historical_snapshot_immutable]]> </comment>
	<position x="2800" y="4880"/>
	<column name="id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="venue_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="resource_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="customer_id">
		<type name="uuid" length="0"/>
		<comment> <![CDATA[NULL allowed for MANUAL — FR-MAN-01]]> </comment>
	</column>
	<column name="source" not-null="true">
		<type name="varchar" length="80"/>
		<comment> <![CDATA[ONLINE · MANUAL]]> </comment>
	</column>
	<column name="status" not-null="true">
		<type name="varchar" length="80"/>
		<comment> <![CDATA[PENDING · VENUE_RESPONSE_EXPIRED · AWAITING_CUSTOMER_CONFIRMATION · CONFIRMED · ACTIVE · COMPLETED · REJECTED · CANCELLED · NO_SHOW]]> </comment>
	</column>
	<column name="activity" not-null="true">
		<type name="varchar" length="80"/>
		<comment> <![CDATA[historical snapshot.]]> </comment>
	</column>
	<column name="console_type">
		<type name="varchar" length="80"/>
		<comment> <![CDATA[historical snapshot. snapshot — survives a later console change]]> </comment>
	</column>
	<column name="play_mode">
		<type name="varchar" length="80"/>
		<comment> <![CDATA[historical snapshot.]]> </comment>
	</column>
	<column name="resource_name_snapshot" not-null="true">
		<type name="text" length="0"/>
		<comment> <![CDATA[historical snapshot.]]> </comment>
	</column>
	<column name="start_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="end_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[start + nominal minutes, real elapsed]]> </comment>
	</column>
	<column name="nominal_booked_minutes" not-null="true">
		<type name="integer" length="0"/>
		<comment> <![CDATA[drives PRICE, never DST-adjusted]]> </comment>
	</column>
	<column name="hourly_price_snapshot" not-null="true">
		<type name="numeric" length="12" precision="2"/>
		<comment> <![CDATA[historical snapshot.]]> </comment>
	</column>
	<column name="venue_price_total" not-null="true">
		<type name="numeric" length="12" precision="2"/>
	</column>
	<column name="booking_fee_snapshot" not-null="true">
		<type name="numeric" length="12" precision="2"/>
		<comment> <![CDATA[historical snapshot. EGP 0 at launch, snapshot at creation]]> </comment>
	</column>
	<column name="fee_treatment">
		<type name="text" length="0"/>
		<comment> <![CDATA[Reason-to-treatment snapshot for REJECTED/CANCELLED outcomes. Values: FULL_REFUND · CUSTOMER_POLICY · NOT_APPLICABLE. COMPLETED/NO_SHOW have no Booking Reason Code and therefore no §34.2 reason treatment.]]> </comment>
	</column>
	<column name="total_amount" not-null="true">
		<type name="numeric" length="12" precision="2"/>
	</column>
	<column name="business_date" not-null="true">
		<type name="date" length="0"/>
		<comment> <![CDATA[the revenue-day key — ALWAYS present]]> </comment>
	</column>
	<column name="operating_day">
		<type name="date" length="0"/>
		<comment> <![CDATA[NULL for manual outside published hours]]> </comment>
	</column>
	<column name="operating_session_id">
		<type name="uuid" length="0"/>
		<comment> <![CDATA[Nullable for Manual Booking outside published Operating Sessions.]]> </comment>
	</column>
	<column name="session_local_start">
		<type name="timestamp" length="0"/>
		<comment> <![CDATA[historical snapshot.]]> </comment>
	</column>
	<column name="session_local_end">
		<type name="timestamp" length="0"/>
		<comment> <![CDATA[historical snapshot.]]> </comment>
	</column>
	<column name="session_timezone">
		<type name="text" length="0"/>
		<comment> <![CDATA[historical snapshot.]]> </comment>
	</column>
	<column name="venue_response_expires_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[persisted 10-minute deadline]]> </comment>
	</column>
	<column name="response_pause_started_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="cumulative_emergency_pause_duration">
		<type name="interval" length="0"/>
		<comment> <![CDATA[30-minute cap]]> </comment>
	</column>
	<column name="late_confirm_pause_started_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="cumulative_late_confirm_emergency_pause_duration">
		<type name="interval" length="0"/>
		<comment> <![CDATA[30-minute cap]]> </comment>
	</column>
	<column name="terminal_reason">
		<type name="varchar" length="80"/>
		<comment> <![CDATA[Required only for REJECTED/CANCELLED; NULL for COMPLETED/NO_SHOW and non-terminal states.]]> </comment>
	</column>
	<column name="terminal_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[drives phone retention]]> </comment>
	</column>
	<column name="venue_reject_reason_text">
		<type name="text" length="0"/>
		<comment> <![CDATA[MANDATORY free text, separate from the code]]> </comment>
	</column>
	<column name="commitment_period">
		<type name="tstzrange" length="0"/>
		<comment> <![CDATA[GENERATED — non-null only while counted]]> </comment>
	</column>
	<column name="manual_customer_name">
		<type name="text" length="0"/>
	</column>
	<column name="manual_customer_phone">
		<type name="text" length="0"/>
	</column>
	<column name="created_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[Used by future 15-minute fee policy.]]> </comment>
	</column>
	<column name="version" not-null="true" default-value="0">
		<type name="bigint" length="0"/>
		<comment> <![CDATA[Optimistic state version.]]> </comment>
	</column>
	<constraint name="booking_pk" type="pk-constr" table="booking.booking">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_booking_duration" type="ck-constr" table="booking.booking">
			<expression> <![CDATA[nominal_booked_minutes BETWEEN 60 AND 360 AND MOD(nominal_booked_minutes,30)=0]]> </expression>
	</constraint>
	<constraint name="ck_booking_terminal_reason" type="ck-constr" table="booking.booking">
			<expression> <![CDATA[((status IN ('REJECTED','CANCELLED') AND terminal_reason IS NOT NULL) OR (status NOT IN ('REJECTED','CANCELLED') AND terminal_reason IS NULL))]]> </expression>
	</constraint>
	<constraint name="ck_booking_source_values" type="ck-constr" table="booking.booking">
			<expression> <![CDATA[source IN ('ONLINE','MANUAL')]]> </expression>
	</constraint>
	<constraint name="ck_booking_status_values" type="ck-constr" table="booking.booking">
			<expression> <![CDATA[status IN ('PENDING','VENUE_RESPONSE_EXPIRED','AWAITING_CUSTOMER_CONFIRMATION','CONFIRMED','ACTIVE','COMPLETED','REJECTED','CANCELLED','NO_SHOW')]]> </expression>
	</constraint>
	<constraint name="ck_booking_activity_values" type="ck-constr" table="booking.booking">
			<expression> <![CDATA[activity IN ('PLAYSTATION','BILLIARDS','PING_PONG')]]> </expression>
	</constraint>
	<constraint name="ck_booking_snapshot_dimensions" type="ck-constr" table="booking.booking">
			<expression> <![CDATA[(activity = 'PLAYSTATION' AND console_type IS NOT NULL AND play_mode IS NOT NULL AND console_type IN ('PS4','PS5') AND play_mode IN ('SINGLE','MULTIPLAYER')) OR (activity IN ('BILLIARDS','PING_PONG') AND console_type IS NULL AND play_mode IS NULL)]]> </expression>
	</constraint>
	<constraint name="ck_booking_terminal_reason_values" type="ck-constr" table="booking.booking">
			<expression> <![CDATA[(terminal_reason IS NULL OR terminal_reason IN ('CUSTOMER_CANCELLED','CUSTOMER_DECLINED_LATE_CONFIRM','CUSTOMER_RECONFIRM_TIMEOUT','VENUE_REJECTED','REJECTED_AFTER_EXPIRY','VENUE_CANCELLED_CONFIRMED_BOOKING','VENUE_CANCELLED_MANUAL_BOOKING','VENUE_DID_NOT_RESPOND_IN_TIME','VENUE_OPENING_HOURS_CHANGED','VENUE_CLOSURE','VENUE_EMERGENCY_CLOSURE','RESOURCE_EMERGENCY_OUTAGE','VENUE_RESPONSE_INTERRUPTED_BY_EMERGENCY','RESOURCE_RESPONSE_INTERRUPTED_BY_EMERGENCY','LATE_CONFIRM_INTERRUPTED_BY_EMERGENCY','RESOURCE_OWNER_REVIEW_REQUIRED','VENUE_ACCOUNT_DISABLED','SYSTEM_RESOURCE_STATE_INTEGRITY_ERROR','USER_BANNED','ADMIN_CANCELLED','ADMIN_CORRECTION','ADMIN_NO_SHOW_REVERSAL'))]]> </expression>
	</constraint>
	<constraint name="ck_booking_online_customer" type="ck-constr" table="booking.booking">
			<expression> <![CDATA[source <> 'ONLINE' OR customer_id IS NOT NULL]]> </expression>
	</constraint>
	<constraint name="ck_booking_commitment_period_shape" type="ck-constr" table="booking.booking">
			<expression> <![CDATA[((source = 'ONLINE' AND customer_id IS NOT NULL AND status IN ('PENDING','AWAITING_CUSTOMER_CONFIRMATION','CONFIRMED','ACTIVE') AND commitment_period IS NOT NULL AND commitment_period = tstzrange(start_at,end_at,'[)')) OR ((source <> 'ONLINE' OR customer_id IS NULL OR status NOT IN ('PENDING','AWAITING_CUSTOMER_CONFIRMATION','CONFIRMED','ACTIVE')) AND commitment_period IS NULL))]]> </expression>
	</constraint>
	<constraint name="ck_booking_manual_states" type="ck-constr" table="booking.booking">
			<expression> <![CDATA[source <> 'MANUAL' OR status IN ('CONFIRMED','ACTIVE','COMPLETED','CANCELLED')]]> </expression>
	</constraint>
	<constraint name="ck_booking_terminal_at" type="ck-constr" table="booking.booking">
			<expression> <![CDATA[((status IN ('COMPLETED','REJECTED','CANCELLED','NO_SHOW') AND terminal_at IS NOT NULL) OR (status NOT IN ('COMPLETED','REJECTED','CANCELLED','NO_SHOW') AND terminal_at IS NULL))]]> </expression>
	</constraint>
	<constraint name="ck_booking_time_math" type="ck-constr" table="booking.booking">
			<expression> <![CDATA[end_at = start_at + make_interval(mins => nominal_booked_minutes)]]> </expression>
	</constraint>
	<constraint name="ck_booking_money_nonnegative" type="ck-constr" table="booking.booking">
			<expression> <![CDATA[hourly_price_snapshot >= 0 AND venue_price_total >= 0 AND booking_fee_snapshot >= 0 AND total_amount >= 0]]> </expression>
	</constraint>
	<constraint name="ck_booking_venue_price_math" type="ck-constr" table="booking.booking">
			<expression> <![CDATA[venue_price_total = ROUND(hourly_price_snapshot * nominal_booked_minutes / 60.0, 2)]]> </expression>
	</constraint>
	<constraint name="ck_booking_total_math" type="ck-constr" table="booking.booking">
			<expression> <![CDATA[total_amount = venue_price_total + booking_fee_snapshot]]> </expression>
	</constraint>
	<constraint name="ck_booking_fee_treatment_values" type="ck-constr" table="booking.booking">
			<expression> <![CDATA[fee_treatment IS NULL OR fee_treatment IN ('FULL_REFUND','CUSTOMER_POLICY','NOT_APPLICABLE')]]> </expression>
	</constraint>
	<constraint name="ck_booking_fee_treatment_scope" type="ck-constr" table="booking.booking">
			<expression> <![CDATA[((status IN ('REJECTED','CANCELLED') AND fee_treatment IS NOT NULL) OR (status NOT IN ('REJECTED','CANCELLED') AND fee_treatment IS NULL))]]> </expression>
	</constraint>
	<constraint name="ck_booking_manual_fee_zero" type="ck-constr" table="booking.booking">
			<expression> <![CDATA[source <> 'MANUAL' OR booking_fee_snapshot = 0]]> </expression>
	</constraint>
	<constraint name="ck_booking_reject_reason_text" type="ck-constr" table="booking.booking">
			<expression> <![CDATA[(terminal_reason IS NOT DISTINCT FROM 'VENUE_REJECTED' AND NULLIF(BTRIM(venue_reject_reason_text),'') IS NOT NULL) OR (terminal_reason IS DISTINCT FROM 'VENUE_REJECTED' AND venue_reject_reason_text IS NULL)]]> </expression>
	</constraint>
	<constraint name="ck_booking_pause_counters" type="ck-constr" table="booking.booking">
			<expression> <![CDATA[(cumulative_emergency_pause_duration IS NULL OR (cumulative_emergency_pause_duration >= interval '0' AND cumulative_emergency_pause_duration <= interval '30 minutes')) AND (cumulative_late_confirm_emergency_pause_duration IS NULL OR (cumulative_late_confirm_emergency_pause_duration >= interval '0' AND cumulative_late_confirm_emergency_pause_duration <= interval '30 minutes'))]]> </expression>
	</constraint>
	<constraint name="ck_booking_pause_state_scope" type="ck-constr" table="booking.booking">
			<expression> <![CDATA[(response_pause_started_at IS NULL OR status = 'PENDING') AND (late_confirm_pause_started_at IS NULL OR status = 'AWAITING_CUSTOMER_CONFIRMATION')]]> </expression>
	</constraint>
</table>

<table name="booking_history" layers="0" collapse-mode="2" max-obj-count="16" z-value="0">
	<schema name="booking"/>
	<role name="postgres"/>
	<comment> <![CDATA[APPEND-ONLY Booking history; this physical table also stores the Architecture's booking_event stream via entry_kind=BOOKING_EVENT. Booking Reason Codes, Booking Events and detailCode are separate closed domains.

Source/critical constraints:
- uq_history_seq
- ck_entry_shape (status transitions and events never conflate)
- ck_transition_terminal_reason (NO_SHOW has no Booking Reason Code)
- ck_detail_code_scope
- append-only mutation trigger]]> </comment>
