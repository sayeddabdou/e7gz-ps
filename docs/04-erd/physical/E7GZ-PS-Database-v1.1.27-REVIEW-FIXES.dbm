	</column>
	<constraint name="venue_opening_template_pk" type="pk-constr" table="venue.venue_opening_template">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="uq_opening_template_venue" type="uq-constr" table="venue.venue_opening_template">
		<columns names="venue_id" ref-type="src-columns"/>
	</constraint>
</table>

<table name="venue_opening_day" layers="0" collapse-mode="2" max-obj-count="7" z-value="0">
	<schema name="venue"/>
	<role name="postgres"/>
	<comment> <![CDATA[Weekday override: DEFAULT inherits template, CUSTOM supplies custom local times, CLOSED creates no session that starts on that Operating Day.

Source/critical constraints:
- UNIQUE (template_id, weekday)]]> </comment>
	<position x="6180" y="1000"/>
	<column name="id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="template_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="weekday" not-null="true">
		<type name="smallint" length="0"/>
		<comment> <![CDATA[0-6]]> </comment>
	</column>
	<column name="mode" not-null="true">
		<type name="text" length="0"/>
		<comment> <![CDATA[DEFAULT · CUSTOM · CLOSED — FR-VEN-17]]> </comment>
	</column>
	<column name="custom_local_open">
		<type name="time" length="0"/>
	</column>
	<column name="custom_local_close">
		<type name="time" length="0"/>
		<comment> <![CDATA[may be <= open -> crosses midnight]]> </comment>
	</column>
	<constraint name="venue_opening_day_pk" type="pk-constr" table="venue.venue_opening_day">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="uq_opening_day" type="uq-constr" table="venue.venue_opening_day">
		<columns names="template_id,weekday" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_opening_day_weekday" type="ck-constr" table="venue.venue_opening_day">
			<expression> <![CDATA[weekday BETWEEN 0 AND 6]]> </expression>
	</constraint>
	<constraint name="ck_opening_day_mode" type="ck-constr" table="venue.venue_opening_day">
			<expression> <![CDATA[mode IN ('DEFAULT','CUSTOM','CLOSED')]]> </expression>
	</constraint>
	<constraint name="ck_opening_day_custom_times" type="ck-constr" table="venue.venue_opening_day">
			<expression> <![CDATA[(mode = 'CUSTOM' AND custom_local_open IS NOT NULL AND custom_local_close IS NOT NULL) OR (mode IN ('DEFAULT','CLOSED') AND custom_local_open IS NULL AND custom_local_close IS NULL)]]> </expression>
	</constraint>
</table>

