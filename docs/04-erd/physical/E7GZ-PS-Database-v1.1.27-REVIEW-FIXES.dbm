<table name="outbox_event" layers="0" collapse-mode="2" max-obj-count="15" z-value="0">
	<schema name="technical"/>
	<role name="postgres"/>
	<comment> <![CDATA[Written in the business transaction. Notifications dispatch ONLY after commit. INSERT: PENDING, attempt 0. Envelope (id, event_type, aggregate, payload, correlation, created_at) immutable. Delivery fields change only through technical.outbox_* worker functions: PENDING -> PENDING (retry) | DISPATCHED | DEAD_LETTER; DISPATCHED and DEAD_LETTER are terminal. No DELETE/TRUNCATE (retention purge requires an explicit future path).]]> </comment>
	<position x="6180" y="11480"/>
	<column name="id" not-null="true">
		<type name="bigint" length="0"/>
	</column>
	<column name="event_type" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="aggregate_type" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="aggregate_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="payload" not-null="true">
		<type name="jsonb" length="0"/>
	</column>
	<column name="correlation_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="state" not-null="true">
		<type name="text" length="0"/>
		<comment> <![CDATA[PENDING · DISPATCHED · DEAD_LETTER]]> </comment>
	</column>
	<column name="attempt" not-null="true">
		<type name="smallint" length="0"/>
	</column>
	<column name="next_attempt_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="dispatched_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="created_at" not-null="true" default-value="clock_timestamp()">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="last_error">
		<type name="text" length="0"/>
	</column>
	<constraint name="outbox_event_pk" type="pk-constr" table="technical.outbox_event">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_outbox_state" type="ck-constr" table="technical.outbox_event">
			<expression> <![CDATA[state IN ('PENDING','DISPATCHED','DEAD_LETTER')]]> </expression>
	</constraint>
	<constraint name="ck_outbox_lifecycle_shape" type="ck-constr" table="technical.outbox_event">
			<expression> <![CDATA[attempt >= 0 AND (state = 'DISPATCHED') = (dispatched_at IS NOT NULL) AND (state <> 'PENDING' OR next_attempt_at IS NOT NULL) AND (state <> 'DEAD_LETTER' OR (last_error IS NOT NULL AND length(btrim(last_error)) > 0)) AND (dispatched_at IS NULL OR dispatched_at >= created_at)]]> </expression>
	</constraint>
	<constraint name="ck_outbox_event_names" type="ck-constr" table="technical.outbox_event">
			<expression> <![CDATA[event_type ~ '^[A-Za-z][A-Za-z0-9_]{0,127}$' AND aggregate_type ~ '^[A-Z][A-Z0-9_]{0,63}$']]> </expression>
	</constraint>
</table>

<table name="idempotency_record" layers="0" collapse-mode="2" max-obj-count="16" z-value="0">
	<schema name="technical"/>
	<role name="postgres"/>
	<comment> <![CDATA[Persistent request idempotency (Architecture). Identity = (principal_type, principal_id, endpoint, idempotency_key). Same key + same request_fingerprint returns the stored logical result; same key + different fingerprint is rejected. Rows are created and completed only through technical.idempotency_begin/complete inside the business transaction, so an IN_PROGRESS row never survives a rolled-back command. Expired rows may be replaced only by technical.idempotency_begin.]]> </comment>
	<position x="6960" y="11480"/>
	<column name="principal_type" not-null="true">
		<type name="text" length="0"/>
		<comment> <![CDATA[CUSTOMER · VENUE · ADMIN · SYSTEM]]> </comment>
	</column>
	<column name="principal_id" not-null="true">
		<type name="uuid" length="0"/>
		<comment> <![CDATA[User / Venue Account / Admin id; for SYSTEM the registered system principal uuid]]> </comment>
	</column>
	<column name="endpoint" not-null="true">
		<type name="text" length="0"/>
		<comment> <![CDATA[API endpoint or command name]]> </comment>
	</column>
	<column name="idempotency_key" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="request_fingerprint" not-null="true">
		<type name="text" length="0"/>
		<comment> <![CDATA[lower-case hex SHA-256 of the canonical request]]> </comment>
	</column>
	<column name="state" not-null="true">
		<type name="text" length="0"/>
		<comment> <![CDATA[IN_PROGRESS · COMPLETED]]> </comment>
	</column>
	<column name="response_status">
		<type name="smallint" length="0"/>
	</column>
	<column name="response_body">
		<type name="jsonb" length="0"/>
		<comment> <![CDATA[Redacted response summary (never a secret)]]> </comment>
	</column>
	<column name="result_aggregate_type">
		<type name="text" length="0"/>
	</column>
	<column name="result_aggregate_id">
		<type name="uuid" length="0"/>
	</column>
	<column name="correlation_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="created_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="completed_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="expires_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<constraint name="idempotency_record_pk" type="pk-constr" table="technical.idempotency_record">
		<columns names="principal_type,principal_id,endpoint,idempotency_key" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_idempotency_values" type="ck-constr" table="technical.idempotency_record">
			<expression> <![CDATA[principal_type IN ('CUSTOMER','VENUE','ADMIN','SYSTEM') AND length(btrim(endpoint)) BETWEEN 1 AND 200 AND length(idempotency_key) BETWEEN 1 AND 255 AND request_fingerprint ~ '^[0-9a-f]{64}$' AND expires_at > created_at]]> </expression>
	</constraint>
	<constraint name="ck_idempotency_state" type="ck-constr" table="technical.idempotency_record">
			<expression> <![CDATA[(state = 'IN_PROGRESS' AND completed_at IS NULL AND response_status IS NULL AND response_body IS NULL) OR (state = 'COMPLETED' AND completed_at IS NOT NULL AND completed_at >= created_at AND response_status IS NOT NULL AND response_status BETWEEN 100 AND 599 AND (result_aggregate_type IS NULL) = (result_aggregate_id IS NULL) AND (response_body IS NULL OR jsonb_typeof(response_body) = 'object'))]]> </expression>
	</constraint>
</table>

<table name="operating_session" layers="0" collapse-mode="2" max-obj-count="12" z-value="0">
