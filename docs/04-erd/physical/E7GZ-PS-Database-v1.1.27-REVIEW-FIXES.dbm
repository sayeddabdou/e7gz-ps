			<expression> <![CDATA[length(btrim(pause_cause)) > 0]]> </expression>
	</constraint>
	<constraint name="ck_pause_history_lifecycle" type="ck-constr" table="operations.booking_timer_pause_history">
			<expression> <![CDATA[(pause_ended_at IS NULL AND (accumulated_duration IS NULL OR accumulated_duration >= interval '0')) OR (pause_ended_at IS NOT NULL AND pause_ended_at >= pause_started_at AND accumulated_duration IS NOT NULL AND accumulated_duration >= (pause_ended_at - pause_started_at) AND accumulated_duration <= interval '30 minutes')]]> </expression>
	</constraint>
</table>

