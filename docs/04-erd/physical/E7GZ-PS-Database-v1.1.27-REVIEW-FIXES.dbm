		<type name="boolean" length="0"/>
	</column>
	<column name="owner_password_outcome">
		<type name="text" length="0"/>
		<comment> <![CDATA[SUCCESS · FAILURE — both audited]]> </comment>
	</column>
	<column name="correlation_id" not-null="true">
		<type name="uuid" length="0"/>
		<comment> <![CDATA[traces a whole cascade]]> </comment>
	</column>
	<column name="payload">
		<type name="jsonb" length="0"/>
		<comment> <![CDATA[redaction-allowlisted — NEVER a secret]]> </comment>
	</column>
	<column name="request_id">
		<type name="uuid" length="0"/>
		<comment> <![CDATA[Inbound request identity where the action originated from an API request]]> </comment>
	</column>
	<column name="previous_state">
		<type name="text" length="0"/>
	</column>
	<column name="new_state">
		<type name="text" length="0"/>
	</column>
	<column name="client_ip">
		<type name="inet" length="0"/>
	</column>
	<column name="client_user_agent">
		<type name="text" length="0"/>
	</column>
	<column name="client_app">
		<type name="text" length="0"/>
	</column>
	<column name="context_user_id">
		<type name="uuid" length="0"/>
	</column>
	<column name="context_venue_id">
		<type name="uuid" length="0"/>
	</column>
	<constraint name="audit_event_pk" type="pk-constr" table="audit.audit_event">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_audit_actor_type" type="ck-constr" table="audit.audit_event">
			<expression> <![CDATA[actor_type IN ('CUSTOMER','VENUE','ADMIN','SYSTEM')]]> </expression>
	</constraint>
	<constraint name="ck_audit_owner_password_outcome" type="ck-constr" table="audit.audit_event">
			<expression> <![CDATA[(owner_password_outcome IS NULL OR owner_password_outcome IN ('SUCCESS','FAILURE'))]]> </expression>
	</constraint>
	<constraint name="ck_audit_owner_password_coherence" type="ck-constr" table="audit.audit_event">
			<expression> <![CDATA[(owner_password_used IS TRUE AND owner_password_outcome IS NOT NULL AND owner_password_outcome IN ('SUCCESS','FAILURE')) OR (owner_password_used IS NOT TRUE AND owner_password_outcome IS NULL)]]> </expression>
	</constraint>
	<constraint name="ck_audit_structured_trace" type="ck-constr" table="audit.audit_event">
			<expression> <![CDATA[(previous_state IS NULL OR new_state IS NOT NULL) AND (previous_state IS NULL OR length(btrim(previous_state)) BETWEEN 1 AND 80) AND (new_state IS NULL OR length(btrim(new_state)) BETWEEN 1 AND 80) AND (client_user_agent IS NULL OR length(client_user_agent) <= 512) AND (client_app IS NULL OR length(btrim(client_app)) BETWEEN 1 AND 80) AND (payload IS NULL OR jsonb_typeof(payload) = 'object')]]> </expression>
	</constraint>
	<constraint name="ck_audit_actor_identity" type="ck-constr" table="audit.audit_event">
			<expression> <![CDATA[(actor_type = 'SYSTEM') = (actor_id IS NULL)]]> </expression>
	</constraint>
	<constraint name="ck_audit_subject_type_format" type="ck-constr" table="audit.audit_event">
