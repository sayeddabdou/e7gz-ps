</table>

<table name="review" layers="0" collapse-mode="2" max-obj-count="10" z-value="0">
	<schema name="review"/>
	<role name="postgres"/>
	<comment> <![CDATA[Phone-verified, non-anonymised registered User may review without a Booking. Rating and non-empty comment are both required. Lifecycle (v1.1.25 guarded): normal create -> ACTIVE; create after an Admin removal (cooldown elapsed) -> PENDING_MODERATION; ACTIVE<->HIDDEN; ACTIVE/HIDDEN/PENDING_MODERATION -> REMOVED (terminal). Only ACTIVE contributes to aggregate rating. Writes only through review.* producers.

Source/critical constraints:
- ux_review_current (user_id, venue_id) WHERE status <> 'REMOVED']]> </comment>
	<position x="200" y="9280"/>
	<column name="id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="user_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="venue_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="rating" not-null="true">
		<type name="smallint" length="0"/>
		<comment> <![CDATA[1-5]]> </comment>
	</column>
	<column name="comment" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="status" not-null="true">
		<type name="varchar" length="80"/>
		<comment> <![CDATA[PENDING_MODERATION · ACTIVE · HIDDEN · REMOVED (terminal)]]> </comment>
	</column>
	<column name="author_deleted_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="created_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[Review date shown by Product; immutable]]> </comment>
	</column>
	<column name="updated_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[Last author edit or lifecycle change]]> </comment>
	</column>
	<constraint name="review_pk" type="pk-constr" table="review.review">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_review_rating" type="ck-constr" table="review.review">
			<expression> <![CDATA[rating BETWEEN 1 AND 5]]> </expression>
	</constraint>
	<constraint name="ck_review_comment" type="ck-constr" table="review.review">
			<expression> <![CDATA[length(trim(comment)) > 0]]> </expression>
	</constraint>
	<constraint name="ck_review_status" type="ck-constr" table="review.review">
			<expression> <![CDATA[status IN ('PENDING_MODERATION','ACTIVE','HIDDEN','REMOVED')]]> </expression>
	</constraint>
	<constraint name="ck_review_timestamps" type="ck-constr" table="review.review">
			<expression> <![CDATA[updated_at >= created_at AND (author_deleted_at IS NULL OR author_deleted_at >= created_at)]]> </expression>
	</constraint>
	<constraint name="ck_review_author_deletion" type="ck-constr" table="review.review">
			<expression> <![CDATA[author_deleted_at IS NULL OR status = 'REMOVED']]> </expression>
	</constraint>
</table>

<table name="review_report" layers="0" collapse-mode="2" max-obj-count="13" z-value="0">
	<schema name="review"/>
	<role name="postgres"/>
	<comment> <![CDATA[PCR-003 / FR-REV-11. Customer abuse-report signal for an ACTIVE public Review. Reporting itself never mutates Review state or rating. Resolution is one-time and may reference an existing moderation event for the same Review.]]> </comment>
	<position x="980" y="9800"/>
	<column name="id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="review_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="reporter_user_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="reason" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="details">
		<type name="text" length="0"/>
	</column>
	<column name="created_at" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="correlation_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="resolved_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="resolved_by_admin_id">
		<type name="uuid" length="0"/>
	</column>
	<column name="resolution_note">
		<type name="text" length="0"/>
	</column>
	<column name="moderation_event_id">
		<type name="uuid" length="0"/>
	</column>
	<constraint name="review_report_pk" type="pk-constr" table="review.review_report">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_review_report_reason" type="ck-constr" table="review.review_report">
			<expression> <![CDATA[length(btrim(reason)) > 0]]> </expression>
	</constraint>
	<constraint name="ck_review_report_resolution" type="ck-constr" table="review.review_report">
			<expression> <![CDATA[(resolved_at IS NULL AND resolved_by_admin_id IS NULL AND resolution_note IS NULL AND moderation_event_id IS NULL) OR (resolved_at IS NOT NULL AND resolved_by_admin_id IS NOT NULL AND NULLIF(btrim(resolution_note),'') IS NOT NULL AND resolved_at >= created_at)]]> </expression>
	</constraint>
</table>

<table name="review_moderation_event" layers="0" collapse-mode="2" max-obj-count="12" z-value="0">
	<schema name="review"/>
	<role name="postgres"/>
	<comment> <![CDATA[APPEND-ONLY (no UPDATE/DELETE/TRUNCATE). One row per Admin moderation command, written atomically with the Review status, Audit event, rating projection and author Outbox event. action must match the exact transition.]]> </comment>
	<position x="980" y="9280"/>
	<column name="id" not-null="true">
