	</constraint>
	<constraint name="ck_tournament_history_transition_shape" type="ck-constr" table="tournament.tournament_history">
			<expression> <![CDATA[(from_status IS NULL OR from_status IS DISTINCT FROM to_status) AND ((to_status IN ('CANCELLED','REJECTED') AND terminal_reason IS NOT NULL) OR (to_status NOT IN ('CANCELLED','REJECTED') AND terminal_reason IS NULL))]]> </expression>
	</constraint>
	<constraint name="ck_tournament_history_rejected_reason" type="ck-constr" table="tournament.tournament_history">
			<expression> <![CDATA[(to_status = 'REJECTED') = (terminal_reason IS NOT DISTINCT FROM 'VENUE_REJECTED_TOURNAMENT')]]> </expression>
	</constraint>
</table>

