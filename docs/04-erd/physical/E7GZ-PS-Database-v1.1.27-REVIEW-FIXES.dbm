<table name="resource_reservation" layers="0" collapse-mode="2" max-obj-count="18" z-value="0">
	<schema name="inventory"/>
	<role name="postgres"/>
	<comment> <![CDATA[Canonical Resource occupancy ledger. A1 CLOSED: overlapping/back-to-back MAINTENANCE rows on the same Resource are allowed and rolling-48h authorization uses their continuous/unioned time. Cross-class conflicts remain enforced: commitments cannot overlap Maintenance/Closure; new Maintenance cannot overlap Closure or commitments; Closure may overlap existing Maintenance after affected commitments are explicitly resolved. The simple GiST exclusion alone MUST NOT be used to forbid Maintenance↔Maintenance.

Source/critical constraints:
- ex_no_double_booking: GiST exclusion on active non-MAINTENANCE planned_range rows
- tr_resource_reservation_cross_class_guard: serializes resource scope and preserves MAINTENANCE↔MAINTENANCE allowance
- ck_reservation_owner_shape (exactly one owner reference by reservation_type)
- ck_reservation_planned_range (planned_range = [planned_start,planned_end))
- ck_reservation_release_chronology]]> </comment>
	<position x="5480" y="3240"/>
	<column name="id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="resource_id" not-null="true">
		<type name="uuid" length="0"/>
	</column>
	<column name="reservation_type" not-null="true">
		<type name="text" length="0"/>
		<comment> <![CDATA[BOOKING · LATE_CONFIRM_HOLD · TOURNAMENT_APPROVAL_HOLD · TOURNAMENT_HOLD · MAINTENANCE · CLOSURE]]> </comment>
	</column>
	<column name="booking_id">
		<type name="uuid" length="0"/>
		<comment> <![CDATA[Nullable; owner for BOOKING/LATE_CONFIRM_HOLD.]]> </comment>
	</column>
	<column name="tournament_id">
		<type name="uuid" length="0"/>
		<comment> <![CDATA[Nullable; owner for Tournament holds.]]> </comment>
	</column>
	<column name="maintenance_id">
		<type name="uuid" length="0"/>
		<comment> <![CDATA[Nullable; owner for MAINTENANCE.]]> </comment>
	</column>
	<column name="closure_id">
		<type name="uuid" length="0"/>
		<comment> <![CDATA[Nullable; owner for derived CLOSURE guard row.]]> </comment>
	</column>
	<column name="planned_start" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[IMMUTABLE planned start.]]> </comment>
	</column>
	<column name="planned_end" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[IMMUTABLE planned end.]]> </comment>
	</column>
	<column name="planned_range" not-null="true">
		<type name="tstzrange" length="0"/>
		<comment> <![CDATA[DERIVED [planned_start,planned_end); trigger-maintained and CHECK-enforced.]]> </comment>
	</column>
	<column name="actual_reservation_start" not-null="true">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[Usually creation/hold time.]]> </comment>
	</column>
	<column name="actual_reservation_release_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
		<comment> <![CDATA[NULL while active.]]> </comment>
	</column>
	<column name="release_reason">
		<type name="text" length="0"/>
		<comment> <![CDATA[Required when released.]]> </comment>
	</column>
	<column name="active_flag" not-null="true" default-value="true">
		<type name="boolean" length="0"/>
		<comment> <![CDATA[Must equal (actual_reservation_release_at IS NULL).]]> </comment>
	</column>
	<column name="version" not-null="true" default-value="0">
		<type name="bigint" length="0"/>
	</column>
	<constraint name="resource_reservation_pk" type="pk-constr" table="inventory.resource_reservation">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_reservation_period" type="ck-constr" table="inventory.resource_reservation">
			<expression> <![CDATA[planned_end > planned_start]]> </expression>
	</constraint>
	<constraint name="ck_reservation_active_release" type="ck-constr" table="inventory.resource_reservation">
			<expression> <![CDATA[active_flag = (actual_reservation_release_at IS NULL)]]> </expression>
	</constraint>
	<constraint name="ck_reservation_release_reason" type="ck-constr" table="inventory.resource_reservation">
			<expression> <![CDATA[((actual_reservation_release_at IS NULL AND release_reason IS NULL) OR (actual_reservation_release_at IS NOT NULL AND release_reason IS NOT NULL))]]> </expression>
	</constraint>
	<constraint name="ck_reservation_owner_shape" type="ck-constr" table="inventory.resource_reservation">
			<expression> <![CDATA[((reservation_type IN ('BOOKING','LATE_CONFIRM_HOLD') AND booking_id IS NOT NULL AND tournament_id IS NULL AND maintenance_id IS NULL AND closure_id IS NULL) OR (reservation_type IN ('TOURNAMENT_APPROVAL_HOLD','TOURNAMENT_HOLD') AND tournament_id IS NOT NULL AND booking_id IS NULL AND maintenance_id IS NULL AND closure_id IS NULL) OR (reservation_type='MAINTENANCE' AND maintenance_id IS NOT NULL AND booking_id IS NULL AND tournament_id IS NULL AND closure_id IS NULL) OR (reservation_type='CLOSURE' AND closure_id IS NOT NULL AND booking_id IS NULL AND tournament_id IS NULL AND maintenance_id IS NULL))]]> </expression>
	</constraint>
	<constraint name="ck_reservation_type" type="ck-constr" table="inventory.resource_reservation">
			<expression> <![CDATA[reservation_type IN ('BOOKING','LATE_CONFIRM_HOLD','TOURNAMENT_APPROVAL_HOLD','TOURNAMENT_HOLD','MAINTENANCE','CLOSURE')]]> </expression>
	</constraint>
	<constraint name="ck_reservation_planned_range" type="ck-constr" table="inventory.resource_reservation">
			<expression> <![CDATA[planned_range = tstzrange(planned_start, planned_end, '[)')]]> </expression>
	</constraint>
	<constraint name="ck_reservation_release_chronology" type="ck-constr" table="inventory.resource_reservation">
			<expression> <![CDATA[actual_reservation_release_at IS NULL OR actual_reservation_release_at >= actual_reservation_start]]> </expression>
	</constraint>
</table>

