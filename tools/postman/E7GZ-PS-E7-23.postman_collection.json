       "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
       "const v = pm.response.json().data;",
       "pm.test(\"ONBOARDING, lat/lng not swapped, activities kept\", () => {",
       "  pm.expect(v.marketplaceStatus).to.eql(\"ONBOARDING\");",
       "  pm.expect(v.location.lat).to.eql(30.0561);",
       "  pm.expect(v.location.lng).to.eql(31.3301);",
       "  pm.expect(v.activities).to.have.members([\"PLAYSTATION\", \"BILLIARDS\"]);",
       "  pm.expect(v.timezone).to.eql(\"Africa/Cairo\");",
       "});",
       "pm.collectionVariables.set(\"venueId\", v.id);"
      ]
     }
    }
