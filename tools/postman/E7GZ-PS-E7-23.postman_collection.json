{
 "info": {
  "name": "E7GZ PS — E7-23 areas, venues, marketplace status",
  "description": "E7-23 PR 2: the Platform Admin's areas, venues and marketplace status, end to end. Needs seed-test-accounts.sql (admin postman.admin@e7gz.test). Run in order with the Collection Runner or `postman collection run`. Each run creates its own area and venue, so it can be re-run.",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "variable": [
  {
   "key": "adminToken",
   "value": ""
  },
  {
   "key": "areaId",
   "value": ""
  },
  {
   "key": "areaName",
   "value": ""
  },
  {
   "key": "venueId",
   "value": ""
  },
  {
   "key": "photoId",
   "value": ""
  },
  {
   "key": "photoUploadUrl",
   "value": ""
  },
  {
   "key": "emptyPhotoId",
   "value": ""
  }
 ],
 "event": [
  {
   "listen": "test",
   "script": {
    "type": "text/javascript",
    "exec": [
     "// Runs after every request (arch 09 §1.3–§1.4).",
     "// Signed photo links go to object storage, not to our API (E7-23 PR 3): skip the API-wide checks there.",
     "if (!pm.request.url.toString().includes(\"/api/v1/\")) return;",
     "pm.test(\"[all] X-Correlation-Id header is a UUID\", () =>",
     "  pm.expect(pm.response.headers.get(\"X-Correlation-Id\") || \"\").to.match(/^[0-9a-f-]{36}$/));",
     "if (pm.response.code >= 400 && (pm.response.headers.get(\"Content-Type\") || \"\").includes(\"json\")) {",
     "  pm.test(\"[all] Error body has a code and no message\", () => {",
     "    const body = pm.response.json();",
     "    pm.expect(body.error.code).to.be.a(\"string\");",
     "    pm.expect(body.error).to.not.have.property(\"message\");",
     "  });",
     "}"
    ]
   }
  }
 ],
 "item": [
  {
   "name": "1 · Admin login",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Origin",
      "value": "http://localhost:5174"
     },
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "body": {
     "mode": "raw",
     "raw": "{\n  \"email\": \"postman.admin@e7gz.test\",\n  \"password\": \"Postman-Test-2026\"\n}"
    },
    "url": "{{baseUrl}}/api/v1/admin/auth/login"
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
       "pm.collectionVariables.set(\"adminToken\", pm.response.json().data.accessToken);"
      ]
     }
    }
   ]
  },
  {
   "name": "2 · Create an area (with centroid) → 201, active",
   "event": [
    {
     "listen": "prerequest",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.collectionVariables.set(\"areaName\", \"Postman Area \" + Date.now());"
      ]
     }
    },
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
       "const a = pm.response.json().data;",
       "pm.test(\"active, centroid stored as sent\", () => {",
       "  pm.expect(a.active).to.eql(true);",
       "  pm.expect(a.centroid.lat).to.eql(30.0561);",
       "  pm.expect(a.centroid.lng).to.eql(31.3301);",
       "});",
       "pm.collectionVariables.set(\"areaId\", a.id);"
      ]
     }
    }
   ],
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{adminToken}}"
     },
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "body": {
     "mode": "raw",
     "raw": "{\n  \"name\": \"{{areaName}}\",\n  \"nameAr\": \"منطقة بوستمان\",\n  \"centroid\": { \"lat\": 30.0561, \"lng\": 31.3301 }\n}"
    },
    "url": "{{baseUrl}}/api/v1/admin/areas"
   }
  },
