# Copy to .env.local (git-ignored) or set in the shell. `pnpm dev:mock` sets both for the Prism mock.
# Backend origin; the API paths already start with /api/v1. Mock: http://127.0.0.1:4010 · local backend: http://localhost:8080
VITE_API_BASE_URL=http://127.0.0.1:4010
# Until venue login exists (E7-14 / E7-21): a placeholder Bearer token. The mock accepts any value; the real backend will not.
VITE_API_ACCESS_TOKEN=mock-access-token
