# Copy to .env.local (git-ignored) or set in the shell; `pnpm start:mock` / `pnpm web:mock` set it for the Prism mock.
# Expo inlines EXPO_PUBLIC_* at bundle time, so restart `expo start` after changing it.
#
# Backend origin — the API paths already start with /api/v1. Which host reaches `pnpm mock` (start it with
# `pnpm mock --host 0.0.0.0` for anything but web on this machine):
#   web / iOS simulator on this machine  http://127.0.0.1:4010
#   Android emulator                     http://10.0.2.2:4010   (the emulator's alias for the host)
#   physical phone (Expo Go, same Wi-Fi) http://<this computer's LAN IP>:4010
# Local backend instead of the mock: the same hosts on port 8080.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:4010

# Inject this from the CI/release secret store for Android builds. Never commit a real key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
