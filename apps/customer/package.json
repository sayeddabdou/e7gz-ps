{
  "name": "@e7gz/customer",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:mock": "cross-env EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:4010 expo start",
    "web:mock": "cross-env EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:4010 expo start --web",
    "build": "expo export --platform web --platform android --output-dir dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@e7gz/api-client": "workspace:*",
    "@e7gz/tokens": "workspace:*",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "expo": "~57.0.25",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "~13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
