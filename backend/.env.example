# Backend deployment settings that are not secrets and have no fixed value yet. Names only: set the values in the
# server's environment (E7-101). Every other E7GZ_* setting is listed, with its local default, in
# src/main/resources/application.yml; secrets come from Sayed privately, never from this file (CLAUDE.md §5).
#
# Terms of Use and Privacy Policy (PCR-013, E7-124). Empty here = the development placeholders of application.yml
# (version "dev"). The Product Owner sets the approved version label (a date such as 2026-11-15) and the two public
# addresses before deployment (E7-125).
E7GZ_LEGAL_TERMS_VERSION=
E7GZ_LEGAL_TERMS_URL=
E7GZ_LEGAL_PRIVACY_URL=
